<Page
    x:Class="Scanner.Views.ScanActionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Scanner.Views"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:converters="using:Scanner.Views.Converters"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:ui="using:CommunityToolkit.WinUI" xmlns:customcontrols="using:Scanner.Controls"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.DataContext>
        <viewModels:ScanActionsViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Unloaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.DisposeCommand}"/>
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>


    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Storyboards -->
            <Storyboard x:Name="StoryboardScanAnimation" RepeatBehavior="Forever">
                <DoubleAnimation
                    x:Name="DoubleAnimationScanAnimation"
                    Storyboard.TargetName="BorderScanAnimation"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                    From="-348"
                    To="348" 
                    Duration="0:0:2.5">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- XAML Converters -->
            <converters:NegativeBoolConverter x:Key="NegativeBoolConverter" />
            <converters:NegativeBoolVisibilityConverter x:Key="NegativeBoolVisibilityConverter" />
            <converters:NotNullBoolConverter x:Key="NotNullBoolConverter" />
            <converters:NullBoolConverter x:Key="NullBoolConverter" />
        </ResourceDictionary>
    </Page.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <Grid x:Name="GridRoot" ui:UIElementExtensions.ClipToBounds="True" SizeChanged="GridRoot_SizeChanged">
        <Border x:Name="BorderScanAnimationBackground" Background="{ThemeResource SystemAccentColor}" ui:VisualExtensions.Opacity="0.0" x:Load="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation To="0.05" Duration="0:0:0.75" />
            </animations:Implicit.ShowAnimations>

            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation To="0.0" Duration="0:0:0.75" />
            </animations:Implicit.HideAnimations>
        </Border>
        <Border x:Name="BorderScanAnimation" x:Load="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Loaded="BorderScanAnimation_Loaded">
            <Border.RenderTransform>
                <TranslateTransform X="-2000" />
            </Border.RenderTransform>
            
            <Border.Background>
                <LinearGradientBrush Opacity="0.15">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Offset="0" Color="{ThemeResource SolidBackgroundFillColorTransparent}" />
                        <GradientStop Offset="0.3" Color="{ThemeResource SystemAccentColorDark1}" />
                        <GradientStop Offset="0.5" Color="{ThemeResource SystemAccentColor}" />
                        <GradientStop Offset="0.7" Color="{ThemeResource SystemAccentColorDark1}" />
                        <GradientStop Offset="1" Color="{ThemeResource SolidBackgroundFillColorTransparent}" />
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Padding="12,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ButtonTemplates" Grid.Column="0" Width="48" Height="48" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource MutedButtonStyle}" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}" x:Load="{x:Bind IsTemplatesButtonVisible, Mode=OneWay}" Loading="ButtonAnimated_Loading" Click="ButtonTemplates_Click">
                <animations:Implicit.ShowAnimations>
                    <animations:ImplicitAnimationSet>
                        <animations:OpacityAnimation Duration="0:0:0.25" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                        <animations:TranslationAnimation Duration="0:0:0.25" From="0,64" To="0,0" EasingMode="EaseInOut"/>
                    </animations:ImplicitAnimationSet>
                </animations:Implicit.ShowAnimations>

                <animations:Implicit.HideAnimations>
                    <animations:ImplicitAnimationSet>
                        <animations:OpacityAnimation Duration="0:0:0.25" To="0.0" EasingMode="EaseInOut" />
                        <animations:TranslationAnimation Duration="0:0:0.25" To="0,64" EasingMode="EaseInOut" />
                    </animations:ImplicitAnimationSet>
                </animations:Implicit.HideAnimations>

                <FontIcon Glyph="&#xE8F1;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </Button>

            <!-- Scan options -->
            <Button x:Name="ButtonScanOptions" Grid.Column="1" Padding="8,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Style="{StaticResource MutedButtonStyle}" x:Load="{x:Bind AreScanOptionsVisible, Mode=OneWay}" Click="ButtonScanOptions_Click">
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation Duration="0:0:0.25" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                    <animations:TranslationAnimation Duration="0:0:0.25" From="0,-64" To="0,0" EasingMode="EaseInOut"/>
                </animations:Implicit.ShowAnimations>

                <animations:Implicit.HideAnimations>
                    <animations:OpacityAnimation Duration="0:0:0.25" To="0.0" EasingMode="EaseInOut" />
                    <animations:TranslationAnimation Duration="0:0:0.25" To="0,-64" EasingMode="EaseInOut" />
                </animations:Implicit.HideAnimations>

                <Grid>
                    <customcontrols:ScanOptionsPresenter x:Name="ScanOptionsPresenter" ScanOptions="{x:Bind ViewModel.ScanOptions, Mode=OneWay}" x:Load="{x:Bind ViewModel.ScanOptions.Scanner, Mode=OneWay, Converter={StaticResource NotNullBoolConverter}}" />
                    <TextBlock x:Name="TextBlockScanOptionsNoScanner" Text="Select a scanner" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" x:Load="{x:Bind ViewModel.ScanOptions.Scanner, Mode=OneWay, Converter={StaticResource NullBoolConverter}}" />
                </Grid>

                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="MenuFlyoutItemTemplates" Text="Templates" Click="MenuFlyoutItemTemplates_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8F1;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>
            </Button>

            <!-- Right buttons -->
            <Button x:Name="ButtonPreview" Grid.Column="2" Margin="8,0,0,0" Width="48" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}" x:Load="{x:Bind IsPreviewButtonVisible, Mode=OneWay}" Loading="ButtonAnimated_Loading">
                <Button.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </Button.Transitions>
                
                <animations:Implicit.ShowAnimations>
                    <animations:ImplicitAnimationSet>
                        <animations:OpacityAnimation Duration="0:0:0.25" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                        <animations:TranslationAnimation Duration="0:0:0.25" From="0,64" To="0,0" EasingMode="EaseInOut"/>
                    </animations:ImplicitAnimationSet>
                </animations:Implicit.ShowAnimations>

                <animations:Implicit.HideAnimations>
                    <animations:ImplicitAnimationSet>
                        <animations:OpacityAnimation Duration="0:0:0.25" To="0.0" EasingMode="EaseInOut" />
                        <animations:TranslationAnimation Duration="0:0:0.25" To="0,64" EasingMode="EaseInOut" />
                    </animations:ImplicitAnimationSet>
                </animations:Implicit.HideAnimations>

                <FontIcon Glyph="&#xE773;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </Button>
            <Button x:Name="ButtonCancel" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Stretch" MinWidth="164" MaxWidth="200" ToolTipService.ToolTip="Cancel scan" Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}" ui:VisualExtensions.Opacity="0.0" x:Load="{x:Bind ViewModel.IsScanning, Mode=OneWay}" PointerEntered="ButtonCancel_PointerEntered" PointerExited="ButtonCancel_PointerExited">
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation Duration="0:0:0.2" Delay="0:0:0.2" To="1.0" />
                </animations:Implicit.ShowAnimations>
                
                <StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Scanning" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Click to cancel" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
               </StackPanel>
            </Button>
            <SplitButton x:Name="SplitButtonScan" Grid.Column="3" Margin="8,0,0,0" HorizontalContentAlignment="Left" VerticalAlignment="Stretch" Padding="8,0,16,0" MinWidth="120" Style="{ThemeResource AccentSplitButtonStyle}" IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}" x:Load="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}" Command="{x:Bind ViewModel.ScanCommand}">
                <animations:Implicit.HideAnimations>
                    <animations:OpacityAnimation Duration="0:0:0.2" To="0.0" />
                </animations:Implicit.HideAnimations>

                <Grid ColumnSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ButtonScanMode" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,4,0" Padding="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource MutedOnAccentButtonStyle}" VerticalAlignment="Center" x:Load="{x:Bind CanScanModeBeSwitched, Mode=OneWay}" Click="ButtonScanMode_Click">
                        <Grid>
                            <FontIcon x:Name="FontIconScanModeAdd" Glyph="&#xE710;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" x:Load="{x:Bind IsAddToProject, Mode=OneWay}">
                                <FontIcon.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromVerticalOffset="4" />
                                    </TransitionCollection>
                                </FontIcon.Transitions>
                            </FontIcon>
                            <FontIcon x:Name="FontIconScanModeNew" Glyph="&#xE8A5;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" x:Load="{x:Bind IsAddToProject, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                                <FontIcon.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromVerticalOffset="4" />
                                    </TransitionCollection>
                                </FontIcon.Transitions>
                            </FontIcon>
                        </Grid>
                    </Button>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Scan" Style="{StaticResource BaseTextBlockStyle}" />
                    <TextBlock x:Name="TextBlockScanModeAdd" Grid.Row="1" Grid.Column="1" Text="Add" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" x:Load="{x:Bind IsAddToProject, Mode=OneWay}">
                        <TextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="4" />
                            </TransitionCollection>
                        </TextBlock.Transitions>
                    </TextBlock>
                    <TextBlock x:Name="TextBlockScanModeNew" Grid.Row="1" Grid.Column="1" Text="New" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" x:Load="{x:Bind IsAddToProject, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                        <TextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="4" />
                            </TransitionCollection>
                        </TextBlock.Transitions>
                    </TextBlock>
                </Grid>

                <SplitButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Scan and add to project" FontWeight="SemiBold">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE710;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Scan to new project">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Scan and merge into project">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEA3C;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Preview">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE773;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Settings">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>
    </Grid>
</Page>
