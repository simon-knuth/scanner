<Page
    x:Class="Scanner.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Scanner.Views"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:converters="using:Scanner.Views.Converters"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:interfaces="using:Scanner.Models.Interfaces"
    xmlns:models="using:Scanner.Models"
    xmlns:teachingtips="using:Scanner.Views.TeachingTips"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.DataContext>
        <viewModels:ProjectViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loading">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.ViewLoadingCommand}" CommandParameter="{x:Bind DispatcherQueue}" />
        </core:EventTriggerBehavior>
        <core:EventTriggerBehavior EventName="Unloaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.DisposeCommand}"/>
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>


    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <media:AttachedCardShadow x:Key="ShadowCarouselPage" Offset="0,2" BlurRadius="6" Color="Black" Opacity="0.04" CornerRadius="2" />
                    <media:AttachedCardShadow x:Key="ShadowCarouselButton" Offset="0,0" BlurRadius="8" Color="Black" Opacity="0.06" CornerRadius="4" />
                    <media:AttachedCardShadow x:Key="ShadowPageListPage" Offset="0,2" BlurRadius="12" Color="Black" Opacity="0.04" CornerRadius="2" />
                    <media:AttachedCardShadow x:Key="ShadowToolbar" Offset="0,4" BlurRadius="12" Color="Black" Opacity="0.04" CornerRadius="8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <media:AttachedCardShadow x:Key="ShadowCarouselPage" Offset="0,2" BlurRadius="6" Color="Black" Opacity="0.2" CornerRadius="2" />
                    <media:AttachedCardShadow x:Key="ShadowCarouselButton" Offset="0,0" BlurRadius="8" Color="Black" Opacity="0.15" CornerRadius="4" />
                    <media:AttachedCardShadow x:Key="ShadowPageListPage" Offset="0,2" BlurRadius="12" Color="Black" Opacity="0.3" CornerRadius="2" />
                    <media:AttachedCardShadow x:Key="ShadowToolbar" Offset="0,4" BlurRadius="12" Color="Black" Opacity="0.04" CornerRadius="8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <media:AttachedCardShadow x:Key="ShadowCarouselPage" Offset="0,0" BlurRadius="0" Color="Transparent" Opacity="0.0" CornerRadius="2" />
                    <media:AttachedCardShadow x:Key="ShadowCarouselButton" Offset="0,0" BlurRadius="0" Color="Transparent" Opacity="0.0" CornerRadius="4" />
                    <media:AttachedCardShadow x:Key="ShadowPageListPage" Offset="0,0" BlurRadius="0" Color="Transparent" Opacity="0.0" CornerRadius="2" />
                    <media:AttachedCardShadow x:Key="ShadowToolbar" Offset="0,0" BlurRadius="0" Color="Transparent" Opacity="0.0" CornerRadius="8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <StaticResource x:Key="GridViewItemBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemBackgroundPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelected" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelectedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelectedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemPointerOverBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemSelectedBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemSelectedPointerOverBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemSelectedPressedBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemSelectedDisabledBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemSelectedInnerBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="GridViewItemBackgroundSelectedDisabled" ResourceKey="SubtleFillColorTransparentBrush" />

            <!-- XAML Converters -->
            <converters:NegativeBoolConverter x:Key="NegativeBoolConverter" />
            <converters:NegativeBoolVisibilityConverter x:Key="NegativeBoolVisibilityConverter" />
            <converters:NotNullBoolConverter x:Key="NotNullBoolConverter" />
            <converters:NullBoolConverter x:Key="NullBoolConverter" />
            <converters:NullVisibilityConverter x:Key="NullVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <Grid x:Name="GridRoot">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Frame Grid.Row="0" IsEnabled="{x:Bind ViewModel.ProjectService.IsProcessRunningOrEditing, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                <Grid x:Name="GridHeader" ColumnSpacing="16" Padding="20,0,12,0" Height="56" SizeChanged="GridHeader_SizeChanged" x:Load="{x:Bind ViewModel.CurrentProject, Mode=OneWay, Converter={StaticResource NotNullBoolConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="EllipseUnsavedChanges" Grid.Row="0" Grid.Column="0" Width="4" Height="4" Margin="-12,4,0,0" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CurrentProject.IsSaved, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}" x:Load="{x:Bind ViewModel.SettingsService.SettingAutoSave, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}" />
                    <Grid Grid.Row="0" Grid.Column="0" Margin="-8,0,-12,-4" Visibility="{x:Bind ViewModel.ProjectService.SelectedPages, Mode=OneWay, Converter={StaticResource NullVisibilityConverter}}">
                        <TextBox x:Name="TextBoxProjectName" Text="{x:Bind ViewModel.FileName}" FontSize="16" Padding="8,4,4,4" MinWidth="120" MinHeight="0" FontWeight="SemiBold" IsSpellCheckEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource MutedTextBoxStyle}" BeforeTextChanging="TextBoxProjectName_BeforeTextChanging" KeyDown="TextBoxProjectName_KeyDown" GotFocus="TextBoxProjectName_GotFocus" LostFocus="TextBoxProjectName_LostFocus">
                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.25" Delay="0:0:0.05" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                            </animations:Implicit.ShowAnimations>

                            <animations:Implicit.HideAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.1" To="0.0" EasingMode="EaseInOut" />
                            </animations:Implicit.HideAnimations>
                        </TextBox>
                        <Button x:Name="ButtonFileNameGeneration" CornerRadius="2" Margin="4,4,6,4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MutedButtonStyle}" Visibility="{x:Bind ShowFileNameGenerationButton, Mode=OneWay}" GettingFocus="ButtonFileNameGeneration_GettingFocus" LostFocus="ButtonFileNameGeneration_LostFocus" Click="ButtonFileNameGeneration_Click" RightTapped="ButtonFileNameGeneration_RightTapped">
                            <Grid Width="24" Height="24">
                                <ImageIcon Margin="4" Visibility="{x:Bind ViewModel.IsFileNameGenerationInProgress, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}">
                                    <ImageIcon.Source>
                                        <SvgImageSource UriSource="/Assets/AI Sparkles.svg" RasterizePixelWidth="32" RasterizePixelHeight="32" />
                                    </ImageIcon.Source>
                                </ImageIcon>
                                
                                <Grid Visibility="{x:Bind ViewModel.IsFileNameGenerationInProgress, Mode=OneWay}">
                                    <ProgressRing Width="20" Height="20" IsActive="True" />
                                    <FontIcon Glyph="&#xEE95;" FontSize="10" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="TextBlockSelectedPagesCount" Grid.Row="0" Grid.Column="0" FontSize="16" Style="{StaticResource BaseTextBlockStyle}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" x:Load="{x:Bind ViewModel.ProjectService.SelectedPages, Mode=OneWay, Converter={StaticResource NotNullBoolConverter}}">
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation Duration="0:0:0.25" Delay="0:0:0.05" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                    </animations:Implicit.ShowAnimations>
                    
                    <Span>
                        <Run Text="{x:Bind ViewModel.ProjectService.SelectedPagesCount, Mode=OneWay}" />
                        <Run Text="pages selected" />
                    </Span>
                    </TextBlock>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.CurrentProject.Format, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="TextBlockTotalPages" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" x:Load="{x:Bind ShowTextBlockTotalPages, Mode=OneWay}">
                        <Span>
                            <Run Text="{x:Bind ViewModel.CurrentProject.Pages.Count, Mode=OneWay}" />
                            <Run Text="pages" />
                        </Span>
                        </TextBlock>
                        <TextBlock x:Name="TextBlockSelectedPage" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Typography.NumeralAlignment="Tabular" Visibility="{x:Bind ViewModel.IsMultiSelect, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}" x:Load="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                        <Span>
                            <Run Text="File" />
                            <Run Text="{x:Bind ViewModel.ProjectService.SelectedPage.PageNumber, Mode=OneWay}" />
                            <Run Text="of" />
                            <Run Text="{x:Bind ViewModel.CurrentProject.Pages.Count, Mode=OneWay}" />
                        </Span>
                        </TextBlock>
                    </StackPanel>
                    <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.IsMultiSelect, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ButtonShowInFileExplorer" ToolTipService.ToolTip="Show in File Explorer" VerticalAlignment="Center" Width="36" Height="36" Style="{StaticResource MutedButtonStyle}" Command="{x:Bind ViewModel.ShowInFileExplorerAsyncCommand}">
                                <FontIcon Glyph="&#xE8DA;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            </Button>
                            <Button x:Name="ButtonMore" ToolTipService.ToolTip="More" VerticalAlignment="Center" Width="36" Height="36" Style="{StaticResource MutedButtonStyle}" Click="ButtonMore_Click">
                                <AnimatedIcon Height="16">
                                    <AnimatedIcon.Source>
                                        <animatedvisuals:AnimatedChevronDownSmallVisualSource />
                                    </AnimatedIcon.Source>
                                    <AnimatedIcon.FallbackIconSource>
                                        <FontIconSource Glyph="&#xE70D;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </AnimatedIcon.FallbackIconSource>
                                </AnimatedIcon>
                            </Button>
                            <Button x:Name="ButtonPageList" Margin="4,0,0,0" Padding="12,4,16,4" VerticalAlignment="Center" CornerRadius="12" Background="{ThemeResource SubtleFillColorTertiaryBrush}" Style="{StaticResource MutedButtonStyle}" Visibility="{x:Bind CanExpandPageList, Mode=OneWay}" Click="ButtonPageList_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7EA;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform Angle="270" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                    <TextBlock Text="Pages" MaxLines="1" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Frame>

                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyout.MenuFlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}" TargetType="MenuFlyoutPresenter">
                                    <Setter Property="Margin" Value="0,-4,0,0" />
                                </Style>
                            </MenuFlyout.MenuFlyoutPresenterStyle>

                            <MenuFlyoutItem Text="Save" Width="{x:Bind ProjectFlyoutWidth, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}" Command="{x:Bind ViewModel.TrySaveAsyncCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>

                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Save as..." IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveAsProject, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE792;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>

                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F12" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Show in File Explorer" Command="{x:Bind ViewModel.ShowInFileExplorerAsyncCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8DA;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem Text="Convert to...">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xEA4E;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutSubItem.Icon>

                                <MenuFlyoutSubItem.Items>
                                    <MenuFlyoutItem Text="PDF">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEA90;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="JPG">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE91B;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="PNG">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE91B;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="BMP">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE91B;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="TIFF">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE91B;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="RAW">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE91B;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyoutSubItem.Items>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Add pages from images..." Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay}" Command="{x:Bind ViewModel.AddFilesCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuFlyoutItemRename" Text="Rename" Click="MenuFlyoutItemRename_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>

                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F2" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Delete" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay}" Command="{x:Bind ViewModel.TryDeleteProjectAsyncCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem Text="Delete" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutSubItem.Icon>

                                <MenuFlyoutSubItem.Items>
                                    <MenuFlyoutItem Text="Current page" Command="{x:Bind ViewModel.TryRemoveCurrentPageAsyncCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Entire project" Command="{x:Bind ViewModel.TryDeleteProjectAsyncCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xF571;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyoutSubItem.Items>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Copy" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay}" Command="{x:Bind ViewModel.TryCopyProjectOrPageAsyncCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem Text="Copy" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutSubItem.Icon>

                                <MenuFlyoutSubItem.Items>
                                    <MenuFlyoutItem Text="Current page" Command="{x:Bind ViewModel.TryCopySelectedPagesAsyncCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Entire project" Command="{x:Bind ViewModel.TryCopyProjectOrPageAsyncCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xF571;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyoutSubItem.Items>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="MenuFlyoutSubItemOpenWith" Text="Open with" Loading="MenuFlyoutSubItemOpenWith_Loading">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE7AC;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutSubItem.Icon>

                                <MenuFlyoutSubItem.Items>
                                    <MenuFlyoutItem Text="Discover more apps in the Store" Command="{x:Bind ViewModel.FindAppForFileTypeCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE719;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Show all apps" FontWeight="SemiBold" Command="{x:Bind ViewModel.TryOpenWithAsyncCommand}" />
                                </MenuFlyoutSubItem.Items>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem Text="Print...">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE749;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Share...">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72D;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Close project" Command="{x:Bind ViewModel.TryCloseProjectAsyncCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE711;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </Grid>
            </Frame>

            <!-- Content -->
            <Frame x:Name="FrameContent" Grid.Row="1" Margin="0,4,0,0" ui:UIElementExtensions.ClipToBounds="True" IsEnabled="{x:Bind ViewModel.ProjectService.IsEditing, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                <Grid>
                    <!-- Carousel -->
                    <Grid x:Name="GridCarousel" Height="92" VerticalAlignment="Top" x:Load="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}" Loading="ControlAnimated_Loading" PointerEntered="GridCarousel_PointerEntered" PointerExited="GridCarousel_PointerExited">
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation Duration="0:0:0.25" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                            <animations:TranslationAnimation Duration="0:0:0.25" From="0,64" To="0,0" EasingMode="EaseInOut"/>
                        </animations:Implicit.ShowAnimations>

                        <animations:Implicit.HideAnimations>
                            <animations:OpacityAnimation Duration="0:0:0.25" To="0.0" EasingMode="EaseInOut" />
                            <animations:TranslationAnimation Duration="0:0:0.25" To="0,64" EasingMode="EaseInOut" />
                        </animations:Implicit.HideAnimations>

                        <GridView x:Name="GridViewCarousel" VerticalContentAlignment="Center" ItemsSource="{x:Bind ViewModel.CurrentProject.Pages, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ProjectService.SelectedPage, Mode=TwoWay, FallbackValue={x:Null}}" SelectionMode="Single" ScrollViewer.HorizontalScrollMode="Auto" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionChanged="GridViewCarousel_SelectionChanged" SizeChanged="GridViewCarousel_SizeChanged">
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection>

                                </TransitionCollection>
                            </GridView.ItemContainerTransitions>

                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel x:Name="ItemsStackPanelCarousel" Orientation="Horizontal" ItemsUpdatingScrollMode="KeepScrollOffset" Loaded="ItemsStackPanelCarousel_Loaded" SizeChanged="ItemsStackPanelCarousel_SizeChanged" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>

                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="interfaces:IProjectPage">
                                    <GridViewItem Margin="0" Width="64" Height="76" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PointerEntered="GridViewItem_PointerEntered" PointerExited="GridViewItem_PointerExited" DataContextChanged="GridViewItem_DataContextChanged">
                                        <Grid>
                                            <Frame Margin="4,4,4,16" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" ui:Effects.Shadow="{ThemeResource ShadowCarouselPage}">
                                                <Image>
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{x:Bind PreviewBitmapUri, Mode=OneWay}" DecodePixelType="Logical" DecodePixelHeight="56" />
                                                    </Image.Source>
                                                </Image>
                                            </Frame>
                                            <Rectangle x:Name="RectangleSelectionIndicatorInner" Width="56" Height="56" Margin="0,4,0,0" RadiusX="4" RadiusY="4" VerticalAlignment="Top" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="0" />
                                            <Rectangle x:Name="RectangleSelectionIndicatorOuter" Width="56" Height="56" Margin="0,4,0,0" RadiusX="4" RadiusY="4" VerticalAlignment="Top" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="0" />
                                            <Grid MinWidth="24" Height="24" Margin="0,0,0,4" Padding="4,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                                                <TextBlock x:Name="TextBlockPageNumber" Text="{x:Bind PageNumber, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Grid>
                                        </Grid>
                                    </GridViewItem>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <Frame x:Name="FrameCarouselButtonPreviousPage" Margin="8,0,0,16" HorizontalAlignment="Left" VerticalAlignment="Center" ui:Effects.Shadow="{ThemeResource ShadowCarouselButton}" Visibility="{x:Bind IsHoveringCarousel, Mode=OneWay}">
                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.25" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                            </animations:Implicit.ShowAnimations>

                            <animations:Implicit.HideAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.25" To="0.0" EasingMode="EaseInOut" />
                            </animations:Implicit.HideAnimations>

                            <Button Width="24" Height="24" Style="{StaticResource AcrylicButtonStyle}" IsEnabled="{x:Bind ViewModel.ProjectService.CanSelectPreviousPage, Mode=OneWay}" Command="{x:Bind ViewModel.SelectPreviousPageCommand}">
                                <Button.RenderTransform>
                                    <RotateTransform Angle="90" CenterX="12" CenterY="12" />
                                </Button.RenderTransform>

                                <AnimatedIcon Height="12">
                                    <AnimatedIcon.Source>
                                        <animatedvisuals:AnimatedChevronDownSmallVisualSource />
                                    </AnimatedIcon.Source>
                                    <AnimatedIcon.FallbackIconSource>
                                        <FontIconSource Glyph="&#xE76B;" FontSize="12" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </AnimatedIcon.FallbackIconSource>
                                </AnimatedIcon>
                            </Button>
                        </Frame>
                        <Frame x:Name="FrameCarouselButtonNextPage" Margin="0,0,8,16" HorizontalAlignment="Right" VerticalAlignment="Center" ui:Effects.Shadow="{ThemeResource ShadowCarouselButton}" Visibility="{x:Bind IsHoveringCarousel, Mode=OneWay}">
                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.25" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                            </animations:Implicit.ShowAnimations>

                            <animations:Implicit.HideAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.25" To="0.0" EasingMode="EaseInOut" />
                            </animations:Implicit.HideAnimations>

                            <Button Width="24" Height="24" Style="{StaticResource AcrylicButtonStyle}" IsEnabled="{x:Bind ViewModel.ProjectService.CanSelectNextPage, Mode=OneWay}" Command="{x:Bind ViewModel.SelectNextPageCommand}">
                                <Button.RenderTransform>
                                    <RotateTransform Angle="270" CenterX="12" CenterY="12" />
                                </Button.RenderTransform>

                                <AnimatedIcon Height="12">
                                    <AnimatedIcon.Source>
                                        <animatedvisuals:AnimatedChevronDownSmallVisualSource />
                                    </AnimatedIcon.Source>
                                    <AnimatedIcon.FallbackIconSource>
                                        <FontIconSource Glyph="&#xE76C;" FontSize="12" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </AnimatedIcon.FallbackIconSource>
                                </AnimatedIcon>
                            </Button>
                        </Frame>
                    </Grid>

                    <Grid x:Name="GridExpanded" x:Load="{x:Bind IsExpanded, Mode=OneWay}">
                        <!-- Page list -->
                        <Grid x:Name="GridPageList" x:Load="{x:Bind ViewModel.CurrentProject, Mode=OneWay, Converter={StaticResource NotNullBoolConverter}}" Loading="ControlAnimated_Loading">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.25" From="0.0" To="1.0" EasingMode="EaseInOut"/>
                                <animations:TranslationAnimation Duration="0:0:0.25" From="0,-64" To="0,0" EasingMode="EaseInOut"/>
                            </animations:Implicit.ShowAnimations>

                            <animations:Implicit.HideAnimations>
                                <animations:OpacityAnimation Duration="0:0:0.25" To="0.0" EasingMode="EaseInOut" />
                                <animations:TranslationAnimation Duration="0:0:0.25" To="0,-64" EasingMode="EaseInOut" />
                            </animations:Implicit.HideAnimations>

                            <GridView x:Name="GridViewPageList" Grid.Row="1" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" ItemsSource="{x:Bind ViewModel.CurrentProject.Pages, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ProjectService.SelectedPage, Mode=OneWay}" SelectionMode="Single" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="GridViewPageList_SelectionChanged" Loaded="GridViewPageList_Loaded" SizeChanged="GridViewPageList_SizeChanged">
                                <GridView.ItemContainerTransitions>
                                    <TransitionCollection>

                                    </TransitionCollection>
                                </GridView.ItemContainerTransitions>

                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="interfaces:IProjectPage">
                                        <GridViewItem Margin="0" Width="108" Height="108" FocusVisualMargin="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PointerEntered="GridViewItem_PointerEntered" PointerExited="GridViewItem_PointerExited" DataContextChanged="GridViewItem_DataContextChanged">
                                            <Grid>
                                                <Frame Margin="8" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" ui:Effects.Shadow="{ThemeResource ShadowPageListPage}">
                                                    <Image>
                                                        <Image.Source>
                                                            <BitmapImage UriSource="{x:Bind PreviewBitmapUri, Mode=OneWay}" DecodePixelType="Logical" DecodePixelHeight="92" />
                                                        </Image.Source>
                                                    </Image>
                                                </Frame>
                                                <Rectangle x:Name="RectangleSelectionIndicatorInner" Width="92" Height="92" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="0" />
                                                <Rectangle x:Name="RectangleSelectionIndicatorOuter" Width="92" Height="92" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="0" />
                                                <Grid MinWidth="24" Height="24" Margin="0,0,0,12" Padding="4,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="4" Background="{ThemeResource SystemControlAcrylicElementMediumHighBrush}">
                                                    <TextBlock x:Name="TextBlockPageNumber" Text="{x:Bind PageNumber, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
                                                </Grid>
                                            </Grid>
                                        </GridViewItem>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <Frame Grid.Row="0" Margin="8,0,8,0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BackgroundSizing="OuterBorderEdge" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ui:Effects.Shadow="{ThemeResource ShadowToolbar}">
                                <Grid ColumnSpacing="8" Padding="4" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Grid.Column="0" Height="32" Padding="12,0,12,0" IsChecked="{x:Bind ViewModel.IsMultiSelect, Mode=TwoWay}" Style="{StaticResource MutedToggleButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" Glyph="&#xE762;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Column="1" Text="Select" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextBlockStyle}" />
                                        </Grid>
                                    </ToggleButton>
                                    <Frame Grid.Column="1" IsEnabled="{x:Bind AreMultiSelectActionsAvailable, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <AppBarSeparator />
                                            <Button x:Name="ButtonRotate" Width="32" Height="32" Style="{StaticResource MutedButtonStyle}" Command="{x:Bind ViewModel.RotateSelectedPages90DegreesAsyncCommand}" ContextRequested="ButtonRotate_ContextRequested">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE7AD;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                    <FontIcon Glyph="&#xE96E;" FontSize="8" Margin="0,0,-8,-8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </Grid>

                                                <FlyoutBase.AttachedFlyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem Text="Rotate 90 degrees" FontWeight="SemiBold" Command="{x:Bind ViewModel.RotateSelectedPages90DegreesAsyncCommand}" />
                                                        <MenuFlyoutItem Text="Rotate 180 degrees" Command="{x:Bind ViewModel.RotateSelectedPages180DegreesAsyncCommand}" />
                                                        <MenuFlyoutItem Text="Rotate 270 degrees" Command="{x:Bind ViewModel.RotateSelectedPages270DegreesAsyncCommand}" />
                                                        <MenuFlyoutItem Text="Rotate automatically" Command="{x:Bind ViewModel.RotateSelectedPagesAutomaticallyAsyncCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <ImageIcon>
                                                                    <ImageIcon.Source>
                                                                        <SvgImageSource UriSource="/Assets/AI Sparkles.svg" RasterizePixelWidth="32" RasterizePixelHeight="32" />
                                                                    </ImageIcon.Source>
                                                                </ImageIcon>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Settings" Command="{x:Bind ViewModel.ShowSettingsCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </FlyoutBase.AttachedFlyout>
                                            </Button>
                                            <Button Width="32" Height="32" Style="{StaticResource MutedButtonStyle}">
                                                <FontIcon Glyph="&#xE790;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <RadioMenuFlyoutItem Text="None" IsChecked="{x:Bind AreFilterNone, Mode=OneWay}" IsEnabled="{x:Bind IsFilterNoneAvailable, Mode=OneWay}" Command="{x:Bind ViewModel.ApplyFilterToSelectedPagesAsyncCommand}" CommandParameter="{x:Bind models:ImageFilter.None}" />
                                                        <RadioMenuFlyoutItem Text="Grayscale" IsChecked="{x:Bind AreFilterGrayscale, Mode=OneWay}" IsEnabled="{x:Bind IsFilterGrayscaleAvailable, Mode=OneWay}" Command="{x:Bind ViewModel.ApplyFilterToSelectedPagesAsyncCommand}" CommandParameter="{x:Bind models:ImageFilter.Grayscale}" />
                                                        <RadioMenuFlyoutItem Text="Monochrome" IsChecked="{x:Bind AreFilterMonochrome, Mode=OneWay}" IsEnabled="{x:Bind IsFilterMonochromeAvailable, Mode=OneWay}" Command="{x:Bind ViewModel.ApplyFilterToSelectedPagesAsyncCommand}" CommandParameter="{x:Bind models:ImageFilter.Monochrome}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Width="32" Height="32" Style="{StaticResource MutedButtonStyle}" Command="{x:Bind ViewModel.RemoveSelectedPagesAsyncCommand}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            </Button>
                                            <Button Width="32" Height="32" Style="{StaticResource MutedButtonStyle}" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}" Command="{x:Bind ViewModel.TryCopySelectedPagesAsyncCommand}">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            </Button>
                                            <Button Width="32" Height="32" Style="{StaticResource MutedButtonStyle}" IsEnabled="False" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}">
                                                <FontIcon Glyph="&#xE72D;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            </Button>
                                        </StackPanel>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </Grid>

                        <!-- Placeholder -->
                        <Grid x:Name="GridPlaceholder" RowSpacing="32" HorizontalAlignment="Center" VerticalAlignment="Center" x:Load="{x:Bind ViewModel.CurrentProject, Mode=OneWay, Converter={StaticResource NullBoolConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="64" Height="88" HorizontalAlignment="Center" Margin="0,0,4,0" Opacity="0.2" Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" ui:VisualExtensions.NormalizedCenterPoint="0.5,0.5" ui:VisualExtensions.RotationAngleInDegrees="-12" />
                            <Border Grid.Row="0" Width="64" Height="88" HorizontalAlignment="Center" Margin="0,4,12,0" Opacity="0.4" Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" ui:VisualExtensions.NormalizedCenterPoint="0.5,0.5" ui:VisualExtensions.RotationAngleInDegrees="8" />
                            <Border Grid.Row="0" Width="64" Height="88" HorizontalAlignment="Center" Margin="0,0,4,0" Opacity="0.8" Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" ui:VisualExtensions.NormalizedCenterPoint="0.5,0.5" ui:VisualExtensions.RotationAngleInDegrees="0">
                                <ui:Effects.Shadow>
                                    <media:AttachedCardShadow Offset="0,0" BlurRadius="8" Color="Black" Opacity="0.05" CornerRadius="4" />
                                </ui:Effects.Shadow>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Scanned pages will appear here" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Frame>
        </Grid>

        <teachingtips:CopilotRuntimeDownloadTeachingTip x:Name="TeachingTipCopilotRuntimeDownload" PreferredPlacement="RightBottom" PlacementMargin="4" ShouldConstrainToRootBounds="False" />
        <teachingtips:AIDisclaimerTeachingTip x:Name="TeachingTipAIDisclaimer" PreferredPlacement="RightBottom" PlacementMargin="4" ShouldConstrainToRootBounds="False" />
    </Grid>
</Page>