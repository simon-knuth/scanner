<Page
    x:Class="Scanner.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:Scanner.Views.Converters"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Scanner"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:strings="using:Scanner.Resources.Strings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:views="using:Scanner.Views"
    FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
    Loading="Page_Loading"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:ShellViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loading">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.ViewLoadingCommand}" CommandParameter="{x:Bind DispatcherQueue}" />
        </core:EventTriggerBehavior>
        <core:EventTriggerBehavior EventName="Unloaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.DisposeCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>


    <!--  - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  -->
    <!--  - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - -  -->
    <!--  - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  XAML Converters  -->
            <converters:NegativeBoolConverter x:Key="NegativeBoolConverter" />
            <converters:NegativeBoolVisibilityConverter x:Key="NegativeBoolVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>


    <!--  - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - -  -->
    <!--  - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - -  -->
    <!--  - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - -  -->
    <Grid
        x:Name="GridRoot"
        AllowDrop="True"
        DragOver="GridRoot_DragOver"
        Drop="GridRoot_Drop"
        Loaded="GridRoot_Loaded"
        SizeChanged="GridRoot_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!--  Titlebar  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColumnDefinitionTitlebarInsetHeader" Width="0" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ColumnDefinitionTitlebarInsetFooter" Width="164" />
                </Grid.ColumnDefinitions>

                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>

                <Border
                    x:Name="BorderTitlebarIcon"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    PointerEntered="BorderTitlebarIcon_PointerEntered"
                    PointerExited="BorderTitlebarIcon_PointerExited">
                    <Image
                        Width="16"
                        Height="16"
                        Source="/Assets/Logo small.svg" />
                </Border>
                <Border
                    x:Name="BorderTitlebarPreview"
                    Grid.Column="2"
                    Margin="-16,0,0,0"
                    Padding="4"
                    VerticalAlignment="Center"
                    x:Load="{x:Bind IsTitlebarPreviewTextVisible, Mode=OneWay}"
                    CornerRadius="4"
                    IsHitTestVisible="False">
                    <animations:Implicit.HideAnimations>
                        <animations:ImplicitAnimationSet>
                            <animations:OpacityAnimation
                                EasingMode="EaseOut"
                                To="0.0"
                                Duration="0:0:0.3" />
                            <animations:TranslationAnimation To="-12,0" Duration="0:0:0.3" />
                        </animations:ImplicitAnimationSet>
                    </animations:Implicit.HideAnimations>

                    <animations:Implicit.ShowAnimations>
                        <animations:ImplicitAnimationSet>
                            <animations:OpacityAnimation
                                From="0.0"
                                To="1.0"
                                Duration="0:0:0.3" />
                            <animations:TranslationAnimation
                                From="-12,0"
                                To="0,0"
                                Duration="0:0:0.3" />
                        </animations:ImplicitAnimationSet>
                    </animations:Implicit.ShowAnimations>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="PREVIEW" />
                </Border>
                <StackPanel
                    x:Name="StackPanelTitlebarButtonsLeft"
                    Grid.Column="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.TryCloseProjectAsyncCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStartNewProject, Mode=OneWay}"
                        Style="{StaticResource TitlebarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind strings:Resources.NewProjectToolTip}">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE8A5;" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.OpenFilesAsyncCommand}"
                        Style="{StaticResource TitlebarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind strings:Resources.OpenProjectToolTip}">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE838;" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        x:Name="ButtonSave"
                        Padding="0"
                        Command="{x:Bind ViewModel.SaveAsyncCommand}"
                        IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}"
                        RightTapped="ButtonSave_RightTapped"
                        Style="{StaticResource TitlebarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind strings:Resources.SaveProjectToolTip}">
                        <Grid>
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="{x:Bind SaveButtonGlyph, Mode=OneWay}" />
                            <ProgressBar
                                x:Name="ProgressBarSave"
                                Width="32"
                                Margin="0,0,0,-10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                x:Load="{x:Bind ViewModel.CurrentProject.IsSaving, Mode=OneWay}"
                                IsHitTestVisible="False"
                                IsIndeterminate="True" />
                        </Grid>

                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.SaveAsyncCommand}"
                                    IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}"
                                    Text="{x:Bind strings:Resources.SaveProject}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>

                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.SaveAsAsyncCommand}"
                                    IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}"
                                    Text="{x:Bind strings:Resources.SaveProjectAs}"
                                    Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE792;" />
                                    </MenuFlyoutItem.Icon>

                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F12" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem
                                    IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}"
                                    Text="{x:Bind strings:Resources.SaveProjectAs}"
                                    Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE792;" />
                                    </MenuFlyoutSubItem.Icon>

                                    <MenuFlyoutSubItem.Items>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.SaveAsCurrentPageAsyncCommand}" Text="{x:Bind strings:Resources.ActionExtentCurrentPage}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    FontSize="16"
                                                    Glyph="&#xE8A5;" />
                                            </MenuFlyoutItem.Icon>

                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="F12" />
                                            </MenuFlyoutItem.KeyboardAccelerators>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.SaveAsAsyncCommand}" Text="{x:Bind strings:Resources.ActionExtentProject}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    FontSize="16"
                                                    Glyph="&#xF571;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyoutSubItem.Items>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ShowSettingsCommand}" Text="{x:Bind strings:Resources.Settings}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        x:Name="ButtonUndo"
                        Command="{x:Bind ViewModel.TryUndoAsyncCommand}"
                        IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                        RightTapped="ButtonUndo_RightTapped"
                        Style="{StaticResource TitlebarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind strings:Resources.UndoToolTip}">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE7A7;" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        x:Name="ButtonRedo"
                        Command="{x:Bind ViewModel.TryRedoAsyncCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                        RightTapped="ButtonRedo_RightTapped"
                        Style="{StaticResource TitlebarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind strings:Resources.RedoToolTip}">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE7A6;" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Y" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
                <StackPanel
                    x:Name="StackPanelTitlebarButtonsRight"
                    Grid.Column="4"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel
                        x:Name="StackPanelTitlebarButtonsRightExpanded"
                        Margin="0,0,8,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ButtonHistory"
                            Click="ButtonHistory_Click"
                            Style="{StaticResource TitlebarButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind strings:Resources.History}">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE81C;" />

                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="H" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Style="{StaticResource TitlebarButtonStyle}" ToolTipService.ToolTip="{x:Bind strings:Resources.Help}">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE897;" />
                        </Button>
                        <Button
                            x:Name="ButtonSupportDevelopment"
                            Command="{x:Bind ViewModel.ShowDonationDialogCommand}"
                            Style="{StaticResource TitlebarButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind strings:Resources.SupportDevelopmentToolTip}">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xED56;" />
                        </Button>
                    </StackPanel>
                    <Button
                        x:Name="ButtonTitlebarMore"
                        RightTapped="ButtonTitlebarMore_RightTapped"
                        Style="{StaticResource TitlebarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind strings:Resources.More}">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE712;" />

                        <Button.Flyout>
                            <MenuFlyout
                                x:Name="MenuFlyoutTitlebarMore"
                                Opening="MenuFlyoutTitlebarMore_Opening"
                                Placement="Bottom">
                                <MenuFlyoutItem
                                    x:Name="MenuFlyoutItemMoreHistory"
                                    x:Load="{x:Bind ShowAllMoreMenuItems, Mode=OneWay}"
                                    Click="MenuFlyoutItemHistory_Click"
                                    Text="{x:Bind strings:Resources.History}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE81C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ShowFeedbackCommand}" Text="{x:Bind strings:Resources.GiveFeedback}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xED15;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="MenuFlyoutItemMoreHelp"
                                    x:Load="{x:Bind ShowAllMoreMenuItems, Mode=OneWay}"
                                    Text="{x:Bind strings:Resources.Help}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE897;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="MenuFlyoutItemChangelog"
                                    Command="{x:Bind ViewModel.ShowChangelogDialogCommand}"
                                    Text="{x:Bind strings:Resources.ChangelogDialogHeading}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xF133;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="MenuFlyoutItemMoreSupportDevelopment"
                                    x:Load="{x:Bind ShowAllMoreMenuItems, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ShowDonationDialogCommand}"
                                    Text="{x:Bind strings:Resources.SupportDevelopment}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xED56;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ShowOtherAppsDialogCommand}" Text="{x:Bind strings:Resources.OtherApps}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xECAD;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ShowSettingsCommand}" Text="{x:Bind strings:Resources.Settings}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <FlyoutBase.AttachedFlyout>
                            <Flyout>
                                <StackPanel
                                    Width="300"
                                    Height="400"
                                    Orientation="Vertical"
                                    Spacing="4">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <controls:SettingsExpander Header="General">
                                        <controls:SettingsExpander.HeaderIcon>
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Glyph="&#xE768;" />
                                        </controls:SettingsExpander.HeaderIcon>

                                        <controls:SettingsExpander.Items>
                                            <controls:SettingsCard
                                                x:Name="SettingsCardDebugResetSettings"
                                                Click="SettingsCardDebugResetSettings_Click"
                                                Header="Reset settings"
                                                IsClickEnabled="True">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="16"
                                                        Glyph="&#xEBC4;" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                        </controls:SettingsExpander.Items>
                                    </controls:SettingsExpander>
                                    <controls:SettingsExpander Header="Dialogs">
                                        <controls:SettingsExpander.HeaderIcon>
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Glyph="&#xE768;" />
                                        </controls:SettingsExpander.HeaderIcon>

                                        <controls:SettingsExpander.Items>
                                            <controls:SettingsCard
                                                x:Name="SettingsCardDebugDialogSaveChanges"
                                                Click="SettingsCardDebugDialogSaveChanges_Click"
                                                Header="Save changes"
                                                IsClickEnabled="True">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="16"
                                                        Glyph="&#xE74E;" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard
                                                x:Name="SettingsCardDebugDialogSetup"
                                                Click="SettingsCardDebugDialogSetup_Click"
                                                Header="Setup"
                                                IsClickEnabled="True">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="16"
                                                        Glyph="&#xEADF;" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard
                                                x:Name="SettingsCardDebugDialogFeedback"
                                                Click="SettingsCardDebugDialogFeedback_Click"
                                                Header="Feedback"
                                                IsClickEnabled="True">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="16"
                                                        Glyph="&#xED15;" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard
                                                x:Name="SettingsCardDebugDialogChangelog"
                                                Click="SettingsCardDebugDialogChangelog_Click"
                                                Header="Changelog"
                                                IsClickEnabled="True">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="16"
                                                        Glyph="&#xF133;" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard
                                                x:Name="SettingsCardDebugDialogUpdated"
                                                Click="SettingsCardDebugDialogUpdated_Click"
                                                Header="Updated"
                                                IsClickEnabled="True">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="16"
                                                        Glyph="&#xE896;" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                        </controls:SettingsExpander.Items>
                                    </controls:SettingsExpander>
                                    <controls:SettingsExpander Header="In-app notifications">
                                        <controls:SettingsExpander.HeaderIcon>
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Glyph="&#xE768;" />
                                        </controls:SettingsExpander.HeaderIcon>

                                        <controls:SettingsExpander.Items>
                                            <controls:SettingsCard>
                                                <controls:SettingsCard.Content>
                                                    <StackPanel Orientation="Vertical" Spacing="12">
                                                        <TextBox Header="Title" Text="{x:Bind DebugNotification.Title, Mode=TwoWay}" />
                                                        <TextBox Header="Message" Text="{x:Bind DebugNotification.Message, Mode=TwoWay}" />
                                                        <ComboBox
                                                            x:Name="ComboBoxDebugInAppNotificationsSeverity"
                                                            Header="Severity"
                                                            SelectedIndex="0">
                                                            <ComboBoxItem Content="Informational" />
                                                            <ComboBoxItem Content="Success" />
                                                            <ComboBoxItem Content="Warning" />
                                                            <ComboBoxItem Content="Error" />
                                                        </ComboBox>
                                                        <Button
                                                            x:Name="ButtonDebugInAppNotification"
                                                            Click="ButtonDebugInAppNotification_Click"
                                                            Content="Show notification" />
                                                    </StackPanel>
                                                </controls:SettingsCard.Content>
                                            </controls:SettingsCard>
                                        </controls:SettingsExpander.Items>
                                    </controls:SettingsExpander>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Content  -->
            <Grid Grid.Row="1" FlowDirection="{x:Bind LayoutFlowDirection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        x:Name="ColumnDefinitionFirst"
                        Width="4*"
                        MinWidth="300"
                        MaxWidth="348" />
                    <ColumnDefinition x:Name="ColumnDefinitionMiddle" Width="6*" />
                    <ColumnDefinition x:Name="ColumnDefinitionLast" Width="0" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="BorderProjectView"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,8,0,0">
                    <views:ProjectView
                        x:Name="ProjectView"
                        CanExpandPageList="{x:Bind ShowExpandButtonInProjectView, Mode=OneWay}"
                        ExpandPageListRequested="ExpandPageListRequested"
                        FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
                        IsExpandedChanged="ProjectView_IsExpandedChanged" />
                </Border>
                <Border
                    x:Name="BorderScanOptions"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="0,152,0,0"
                    ui:UIElementExtensions.ClipToBounds="True"
                    BorderThickness="0,1,0,0">
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation To="1.0" Duration="{x:Bind ScanOptionsOpacityAnimationDuration, Mode=OneWay}" />
                        <animations:TranslationAnimation
                            EasingMode="EaseInOut"
                            To="0,0"
                            Duration="{x:Bind ScanOptionsTranslationAnimationDuration, Mode=OneWay}" />
                    </animations:Implicit.ShowAnimations>

                    <animations:Implicit.HideAnimations>
                        <animations:OpacityAnimation To="0.0" Duration="{x:Bind ScanOptionsOpacityAnimationDuration, Mode=OneWay}" />
                        <animations:TranslationAnimation
                            EasingMode="EaseInOut"
                            To="0,64"
                            Duration="{x:Bind ScanOptionsTranslationAnimationDuration, Mode=OneWay}" />
                    </animations:Implicit.HideAnimations>

                    <views:ScanOptionsView
                        x:Name="ScanOptionsView"
                        CanExpandPageList="True"
                        ExpandPageListRequested="ExpandPageListRequested"
                        FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
                        PropertyChanged="ScanOptionsView_PropertyChanged" />
                </Border>

                <Border
                    x:Name="BorderScanActionsView"
                    Grid.Row="1"
                    Grid.Column="0">
                    <views:ScanActionsView
                        x:Name="ScanActionsView"
                        Height="72"
                        AreScanOptionsVisibleChanged="ScanActionsView_AreScanOptionsVisibleChanged"
                        ExpandScanOptionsRequested="ScanActionsView_ExpandScanOptionsRequested"
                        FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
                        ScanOptions="{x:Bind ScanOptionsView.ScanOptions, Mode=OneWay}" />
                </Border>
                <Line
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Stretch="Fill"
                    Stroke="{ThemeResource DividerStrokeColorDefault}"
                    StrokeThickness="1"
                    Visibility="{x:Bind ShowScanActionsDivider, Mode=OneWay}"
                    X1="0"
                    X2="1" />

                <Border
                    x:Name="BorderEditor"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                    <views:EditorView FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}" />
                </Border>

                <controls:GridSplitter
                    x:Name="GridSplitterMiddle"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Left"
                    CornerRadius="8,0,0,0"
                    IsThumbVisible="False"
                    ResizeBehavior="PreviousAndCurrent"
                    ResizeDirection="Columns" />
                <controls:GridSplitter
                    x:Name="GridSplitterLast"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Right"
                    CornerRadius="0,8,0,0"
                    IsThumbVisible="False"
                    ResizeBehavior="BasedOnAlignment"
                    ResizeDirection="Columns"
                    Visibility="Collapsed" />
            </Grid>

            <!--  Notifications  -->
            <Frame
                Grid.Row="1"
                Grid.Column="0"
                Margin="24,24,24,72"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                ui:VisualExtensions.NormalizedCenterPoint="0.5,1"
                ui:VisualExtensions.Scale="0,0"
                Background="{ThemeResource SystemControlAcrylicElementBrush}"
                CornerRadius="8"
                Visibility="{x:Bind InfoBarNotifications.IsOpen, Mode=OneWay}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="24"
                        CornerRadius="8"
                        Opacity="0.1"
                        Offset="0,4"
                        Color="Black" />
                </ui:Effects.Shadow>

                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation
                        From="0.0"
                        To="1.0"
                        Duration="0:0:0.5" />
                    <animations:ScaleAnimation
                        EasingMode="EaseOut"
                        From="0,0"
                        To="1,1"
                        Duration="0:0:0.5" />
                </animations:Implicit.ShowAnimations>

                <InfoBar
                    x:Name="InfoBarNotifications"
                    MaxWidth="448"
                    CornerRadius="8">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StackedNotificationsBehavior x:Name="NotificationQueue" />
                    </interactivity:Interaction.Behaviors>
                </InfoBar>
            </Frame>
        </Grid>

        <TeachingTip
            x:Name="TeachingTipFeedback"
            Title="{x:Bind strings:Resources.FeedbackDialogHeading}"
            PlacementMargin="4"
            PreferredPlacement="Bottom"
            Subtitle="{x:Bind strings:Resources.FeedbackDialogSubheading}">
            <TeachingTip.IconSource>
                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xED15;" />
            </TeachingTip.IconSource>

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Vertical"
                Spacing="4">
                <Button
                    x:Name="ButtonTeachingTipFeedbackGiveFeedback"
                    HorizontalAlignment="Stretch"
                    Click="ButtonTeachingTipFeedbackGiveFeedback_Click"
                    Command="{x:Bind ViewModel.ShowFeedbackCommand}"
                    Content="{x:Bind strings:Resources.GiveFeedback}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ShowDonationDialogCommand}"
                    Content="{x:Bind strings:Resources.SupportDevelopment}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </TeachingTip>

        <TeachingTip
            x:Name="TeachingTipUpdated"
            Title="{x:Bind strings:Resources.AppUpdatedDialogHeading}"
            ActionButtonCommand="{x:Bind ViewModel.ShowChangelogDialogCommand}"
            ActionButtonContent="{x:Bind strings:Resources.Changelog}"
            ActionButtonStyle="{StaticResource AccentButtonStyle}"
            PlacementMargin="4"
            PreferredPlacement="Bottom"
            Subtitle="{x:Bind strings:Resources.AppUpdatedDialogBody}">
            <TeachingTip.IconSource>
                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF133;" />
            </TeachingTip.IconSource>
        </TeachingTip>
        <!--  VisualStates  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VisualStateGroup" CurrentStateChanged="VisualStateGroup_CurrentStateChanged">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers />

                    <Storyboard />

                    <VisualState.Setters>
                        <Setter Target="StackPanelTitlebarButtonsRightExpanded.Visibility" Value="Collapsed" />
                        <Setter Target="ColumnDefinitionFirst.MaxWidth" Value="2000" />
                        <Setter Target="ColumnDefinitionMiddle.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                        <Setter Target="GridSplitterMiddle.Visibility" Value="Collapsed" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="BorderScanOptions.Margin" Value="0,152,0,0" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,0,0,0" />
                        <Setter Target="BorderScanOptions.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderScanOptions.BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Setter Target="BorderScanActionsView.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderEditor.(Grid.Column)" Value="0" />
                        <Setter Target="BorderEditor.(Grid.RowSpan)" Value="1" />
                        <Setter Target="BorderEditor.Margin" Value="0,152,0,0" />
                        <Setter Target="BorderEditor.CornerRadius" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateNarrowNoProject">
                    <VisualState.StateTriggers />

                    <Storyboard />

                    <VisualState.Setters>
                        <Setter Target="StackPanelTitlebarButtonsRightExpanded.Visibility" Value="Collapsed" />
                        <Setter Target="ColumnDefinitionFirst.MaxWidth" Value="2000" />
                        <Setter Target="ColumnDefinitionMiddle.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                        <Setter Target="GridSplitterMiddle.Visibility" Value="Collapsed" />
                        <Setter Target="BorderProjectView.Visibility" Value="Collapsed" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,8,0,0" />
                        <Setter Target="BorderScanOptions.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderScanOptions.BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Setter Target="BorderScanActionsView.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderEditor.(Grid.Column)" Value="0" />
                        <Setter Target="BorderEditor.(Grid.RowSpan)" Value="1" />
                        <Setter Target="BorderEditor.Margin" Value="0,152,0,0" />
                        <Setter Target="BorderEditor.CornerRadius" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateDefault">
                    <VisualState.StateTriggers />

                    <Storyboard />

                    <VisualState.Setters>
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateDefaultNoProject">
                    <VisualState.StateTriggers />

                    <Storyboard />

                    <VisualState.Setters>
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                        <Setter Target="BorderProjectView.Visibility" Value="Collapsed" />
                        <Setter Target="BorderScanOptions.Visibility" Value="Visible" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,8,0,0" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="ScanActionsView.AreScanOptionsVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers />

                    <Storyboard />

                    <VisualState.Setters>
                        <Setter Target="ColumnDefinitionLast.Width" Value="348" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="300" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="{x:Bind RightPaneMaxWidth}" />
                        <Setter Target="GridSplitterLast.Visibility" Value="Visible" />
                        <Setter Target="BorderProjectView.(Grid.Column)" Value="2" />
                        <Setter Target="BorderProjectView.(Grid.RowSpan)" Value="2" />
                        <Setter Target="ProjectView.IsExpanded" Value="True" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,8,0,0" />
                        <Setter Target="BorderScanOptions.Visibility" Value="Visible" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="ScanOptionsView.Visibility" Value="Visible" />
                        <Setter Target="ScanActionsView.AreScanOptionsVisible" Value="False" />
                        <Setter Target="BorderEditor.BorderThickness" Value="1,1,1,0" />
                        <Setter Target="BorderEditor.CornerRadius" Value="8,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
