<Page
    x:Class="Scanner.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Scanner.Views"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:converters="using:Scanner.Views.Converters"
    xmlns:strings="using:Scanner.Resources.Strings"
    xmlns:local="using:Scanner"
    mc:Ignorable="d"
    FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
    Loading="Page_Loading">

    <Page.DataContext>
        <viewModels:ShellViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loading">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.ViewLoadingCommand}" CommandParameter="{x:Bind DispatcherQueue}" />
        </core:EventTriggerBehavior>
        <core:EventTriggerBehavior EventName="Unloaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.DisposeCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>


    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- XAML Converters -->
            <converters:NegativeBoolConverter x:Key="NegativeBoolConverter" />
            <converters:NegativeBoolVisibilityConverter x:Key="NegativeBoolVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <Grid x:Name="GridRoot" AllowDrop="True" SizeChanged="GridRoot_SizeChanged" Loaded="GridRoot_Loaded" DragOver="GridRoot_DragOver" Drop="GridRoot_Drop">
        <!-- VisualStates -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VisualStateGroup" CurrentStateChanged="VisualStateGroup_CurrentStateChanged">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers>

                    </VisualState.StateTriggers>

                    <Storyboard>

                    </Storyboard>

                    <VisualState.Setters>
                        <Setter Target="StackPanelTitlebarButtonsRightExpanded.Visibility" Value="Collapsed" />
                        <Setter Target="ColumnDefinitionFirst.MaxWidth" Value="2000" />
                        <Setter Target="ColumnDefinitionMiddle.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                        <Setter Target="GridSplitterMiddle.Visibility" Value="Collapsed" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="BorderScanOptions.Margin" Value="0,152,0,0" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,0,0,0" />
                        <Setter Target="BorderScanOptions.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderScanOptions.BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Setter Target="BorderScanActionsView.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderEditor.(Grid.Column)" Value="0" />
                        <Setter Target="BorderEditor.(Grid.RowSpan)" Value="1" />
                        <Setter Target="BorderEditor.Margin" Value="0,152,0,0" />
                        <Setter Target="BorderEditor.CornerRadius" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateNarrowNoProject">
                    <VisualState.StateTriggers>

                    </VisualState.StateTriggers>

                    <Storyboard>

                    </Storyboard>

                    <VisualState.Setters>
                        <Setter Target="StackPanelTitlebarButtonsRightExpanded.Visibility" Value="Collapsed" />
                        <Setter Target="ColumnDefinitionFirst.MaxWidth" Value="2000" />
                        <Setter Target="ColumnDefinitionMiddle.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                        <Setter Target="GridSplitterMiddle.Visibility" Value="Collapsed" />
                        <Setter Target="BorderProjectView.Visibility" Value="Collapsed" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,8,0,0" />
                        <Setter Target="BorderScanOptions.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderScanOptions.BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Setter Target="BorderScanActionsView.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                        <Setter Target="BorderEditor.(Grid.Column)" Value="0" />
                        <Setter Target="BorderEditor.(Grid.RowSpan)" Value="1" />
                        <Setter Target="BorderEditor.Margin" Value="0,152,0,0" />
                        <Setter Target="BorderEditor.CornerRadius" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateDefault">
                    <VisualState.StateTriggers>

                    </VisualState.StateTriggers>

                    <Storyboard>

                    </Storyboard>

                    <VisualState.Setters>
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateDefaultNoProject">
                    <VisualState.StateTriggers>

                    </VisualState.StateTriggers>

                    <Storyboard>

                    </Storyboard>

                    <VisualState.Setters>
                        <Setter Target="ColumnDefinitionLast.Width" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="0" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="0" />
                        <Setter Target="BorderProjectView.Visibility" Value="Collapsed" />
                        <Setter Target="BorderScanOptions.Visibility" Value="Visible" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,8,0,0" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="ScanActionsView.AreScanOptionsVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers>

                    </VisualState.StateTriggers>

                    <Storyboard>

                    </Storyboard>

                    <VisualState.Setters>
                        <Setter Target="ColumnDefinitionLast.Width" Value="348" />
                        <Setter Target="ColumnDefinitionLast.MinWidth" Value="300" />
                        <Setter Target="ColumnDefinitionLast.MaxWidth" Value="{x:Bind RightPaneMaxWidth}" />
                        <Setter Target="GridSplitterLast.Visibility" Value="Visible" />
                        <Setter Target="BorderProjectView.(Grid.Column)" Value="2" />
                        <Setter Target="BorderProjectView.(Grid.RowSpan)" Value="2" />
                        <Setter Target="ProjectView.IsExpanded" Value="True" />
                        <Setter Target="BorderScanOptions.Padding" Value="0,8,0,0" />
                        <Setter Target="BorderScanOptions.Visibility" Value="Visible" />
                        <Setter Target="ScanOptionsView.CanExpandPageList" Value="False" />
                        <Setter Target="ScanOptionsView.Visibility" Value="Visible" />
                        <Setter Target="ScanActionsView.AreScanOptionsVisible" Value="False" />
                        <Setter Target="BorderEditor.BorderThickness" Value="1,1,1,0" />
                        <Setter Target="BorderEditor.CornerRadius" Value="8,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColumnDefinitionTitlebarInsetHeader" Width="0" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ColumnDefinitionTitlebarInsetFooter" Width="164" />
                </Grid.ColumnDefinitions>

                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>

                <Border x:Name="BorderTitlebarIcon" Grid.Column="1" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" PointerEntered="BorderTitlebarIcon_PointerEntered" PointerExited="BorderTitlebarIcon_PointerExited" >
                    <Image Source="/Assets/Logo small.svg" Width="16" Height="16" />
                </Border>
                <Border x:Name="BorderTitlebarPreview" Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Margin="-16,0,0,0" Padding="4" IsHitTestVisible="False" x:Load="{x:Bind IsTitlebarPreviewTextVisible, Mode=OneWay}">
                    <animations:Implicit.HideAnimations>
                        <animations:ImplicitAnimationSet>
                            <animations:OpacityAnimation To="0.0" Duration="0:0:0.3" EasingMode="EaseOut" />
                            <animations:TranslationAnimation To="-12,0" Duration="0:0:0.3" />
                        </animations:ImplicitAnimationSet>
                    </animations:Implicit.HideAnimations>

                    <animations:Implicit.ShowAnimations>
                        <animations:ImplicitAnimationSet>
                            <animations:OpacityAnimation From="0.0" To="1.0" Duration="0:0:0.3" />
                            <animations:TranslationAnimation From="-12,0" To="0,0" Duration="0:0:0.3" />
                        </animations:ImplicitAnimationSet>
                    </animations:Implicit.ShowAnimations>

                    <TextBlock Text="PREVIEW" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel x:Name="StackPanelTitlebarButtonsLeft" Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.NewProjectToolTip}" Style="{StaticResource TitlebarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanStartNewProject, Mode=OneWay}" Command="{x:Bind ViewModel.TryCloseProjectAsyncCommand}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.OpenProjectToolTip}" Style="{StaticResource TitlebarButtonStyle}" IsEnabled="{x:Bind ViewModel.ProjectService.IsProcessRunning, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}" Command="{x:Bind ViewModel.OpenFilesAsyncCommand}">
                        <FontIcon Glyph="&#xE838;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="ButtonSave" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0" ToolTipService.ToolTip="{x:Bind strings:Resources.SaveProjectToolTip}" Style="{StaticResource TitlebarButtonStyle}" IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}" Command="{x:Bind ViewModel.SaveAsyncCommand}" RightTapped="ButtonSave_RightTapped">
                        <Grid>
                            <FontIcon Glyph="{x:Bind SaveButtonGlyph, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            <ProgressBar x:Name="ProgressBarSave" Width="32" Margin="0,0,0,-10" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsIndeterminate="True" x:Load="{x:Bind ViewModel.CurrentProject.IsSaving, Mode=OneWay}" />
                        </Grid>

                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="{x:Bind strings:Resources.SaveProject}" IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}" Command="{x:Bind ViewModel.SaveAsyncCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>

                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{x:Bind strings:Resources.SaveProjectAs}" IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay}" Command="{x:Bind ViewModel.SaveAsAsyncCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE792;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>

                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F12" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem Text="{x:Bind strings:Resources.SaveProjectAs}" IsEnabled="{x:Bind ViewModel.ProjectService.CanSaveProject, Mode=OneWay}" Visibility="{x:Bind ViewModel.CurrentProject.IsPdf, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE792;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutSubItem.Icon>

                                    <MenuFlyoutSubItem.Items>
                                        <MenuFlyoutItem Text="{x:Bind strings:Resources.ActionExtentCurrentPage}" Command="{x:Bind ViewModel.SaveAsCurrentPageAsyncCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A5;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            </MenuFlyoutItem.Icon>

                                            <MenuFlyoutItem.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="F12" />
                                            </MenuFlyoutItem.KeyboardAccelerators>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="{x:Bind strings:Resources.ActionExtentProject}" Command="{x:Bind ViewModel.SaveAsAsyncCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF571;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyoutSubItem.Items>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind strings:Resources.Settings}" Command="{x:Bind ViewModel.ShowSettingsCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="ButtonUndo" Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.UndoToolTip}" Style="{StaticResource TitlebarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Command="{x:Bind ViewModel.TryUndoAsyncCommand}" RightTapped="ButtonUndo_RightTapped">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Z" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="ButtonRedo" Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.RedoToolTip}" Style="{StaticResource TitlebarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" Command="{x:Bind ViewModel.TryRedoAsyncCommand}" RightTapped="ButtonRedo_RightTapped">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Y" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="StackPanelTitlebarButtonsRight" Grid.Column="4" Orientation="Horizontal" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="StackPanelTitlebarButtonsRightExpanded" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                        <Button x:Name="ButtonHistory" Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.History}" Style="{StaticResource TitlebarButtonStyle}" Click="ButtonHistory_Click">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="H" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.Help}" Style="{StaticResource TitlebarButtonStyle}">
                            <FontIcon Glyph="&#xE897;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Button>
                        <Button x:Name="ButtonSupportDevelopment" Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.SupportDevelopmentToolTip}" Style="{StaticResource TitlebarButtonStyle}" Command="{x:Bind ViewModel.ShowDonationDialogCommand}">
                            <FontIcon Glyph="&#xED56;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="ButtonTitlebarMore" Foreground="{ThemeResource TextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind strings:Resources.More}" Style="{StaticResource TitlebarButtonStyle}" RightTapped="ButtonTitlebarMore_RightTapped">
                        <FontIcon Glyph="&#xE712;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />

                        <Button.Flyout>
                            <MenuFlyout x:Name="MenuFlyoutTitlebarMore" Placement="Bottom" Opening="MenuFlyoutTitlebarMore_Opening">
                                <MenuFlyoutItem x:Name="MenuFlyoutItemMoreHistory" Text="{x:Bind strings:Resources.History}" Click="MenuFlyoutItemHistory_Click" x:Load="{x:Bind ShowAllMoreMenuItems, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE81C;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{x:Bind strings:Resources.GiveFeedback}" Command="{x:Bind ViewModel.ShowFeedbackCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED15;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuFlyoutItemMoreHelp" Text="{x:Bind strings:Resources.Help}" x:Load="{x:Bind ShowAllMoreMenuItems, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE897;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuFlyoutItemChangelog" Text="{x:Bind strings:Resources.ChangelogDialogHeading}" Command="{x:Bind ViewModel.ShowChangelogDialogCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF133;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuFlyoutItemMoreSupportDevelopment" Text="{x:Bind strings:Resources.SupportDevelopment}" Command="{x:Bind ViewModel.ShowDonationDialogCommand}" x:Load="{x:Bind ShowAllMoreMenuItems, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED56;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{x:Bind strings:Resources.OtherApps}" Command="{x:Bind ViewModel.ShowOtherAppsDialogCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xECAD;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{x:Bind strings:Resources.Settings}" Command="{x:Bind ViewModel.ShowSettingsCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <FlyoutBase.AttachedFlyout>
                            <Flyout>
                                <StackPanel Orientation="Vertical" Spacing="4" Width="300" Height="400">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <controls:SettingsExpander Header="General">
                                        <controls:SettingsExpander.HeaderIcon>
                                            <FontIcon Glyph="&#xE768;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </controls:SettingsExpander.HeaderIcon>

                                        <controls:SettingsExpander.Items>
                                            <controls:SettingsCard x:Name="SettingsCardDebugResetSettings" Header="Reset settings" IsClickEnabled="True" Click="SettingsCardDebugResetSettings_Click">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xEBC4;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Name="SettingsCardDebugCrash" Header="Test crash" IsClickEnabled="True" Click="SettingsCardDebugCrash_Click">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xE81F;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                        </controls:SettingsExpander.Items>
                                    </controls:SettingsExpander>
                                    <controls:SettingsExpander Header="Dialogs">
                                        <controls:SettingsExpander.HeaderIcon>
                                            <FontIcon Glyph="&#xE768;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </controls:SettingsExpander.HeaderIcon>

                                        <controls:SettingsExpander.Items>
                                            <controls:SettingsCard x:Name="SettingsCardDebugDialogSaveChanges" Header="Save changes" IsClickEnabled="True" Click="SettingsCardDebugDialogSaveChanges_Click">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xE74E;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Name="SettingsCardDebugDialogSetup" Header="Setup" IsClickEnabled="True" Click="SettingsCardDebugDialogSetup_Click">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xEADF;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Name="SettingsCardDebugDialogFeedback" Header="Feedback" IsClickEnabled="True" Click="SettingsCardDebugDialogFeedback_Click">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xED15;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Name="SettingsCardDebugDialogChangelog" Header="Changelog" IsClickEnabled="True" Click="SettingsCardDebugDialogChangelog_Click">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xF133;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                            <controls:SettingsCard x:Name="SettingsCardDebugDialogUpdated" Header="Updated" IsClickEnabled="True" Click="SettingsCardDebugDialogUpdated_Click">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xE896;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </controls:SettingsCard.HeaderIcon>
                                            </controls:SettingsCard>
                                        </controls:SettingsExpander.Items>
                                    </controls:SettingsExpander>
                                    <controls:SettingsExpander Header="In-app notifications">
                                        <controls:SettingsExpander.HeaderIcon>
                                            <FontIcon Glyph="&#xE768;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        </controls:SettingsExpander.HeaderIcon>

                                        <controls:SettingsExpander.Items>
                                            <controls:SettingsCard>
                                                <controls:SettingsCard.Content>
                                                    <StackPanel Orientation="Vertical" Spacing="12">
                                                        <TextBox Header="Title" Text="{x:Bind DebugNotification.Title, Mode=TwoWay}" />
                                                        <TextBox Header="Message" Text="{x:Bind DebugNotification.Message, Mode=TwoWay}" />
                                                        <ComboBox x:Name="ComboBoxDebugInAppNotificationsSeverity" Header="Severity" SelectedIndex="0">
                                                            <ComboBoxItem Content="Informational" />
                                                            <ComboBoxItem Content="Success" />
                                                            <ComboBoxItem Content="Warning" />
                                                            <ComboBoxItem Content="Error" />
                                                        </ComboBox>
                                                        <Button x:Name="ButtonDebugInAppNotification" Content="Show notification" Click="ButtonDebugInAppNotification_Click" />
                                                    </StackPanel>
                                                </controls:SettingsCard.Content>
                                            </controls:SettingsCard>
                                        </controls:SettingsExpander.Items>
                                    </controls:SettingsExpander>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" FlowDirection="{x:Bind LayoutFlowDirection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColumnDefinitionFirst" Width="4*" MinWidth="300" MaxWidth="348" />
                    <ColumnDefinition x:Name="ColumnDefinitionMiddle" Width="6*" />
                    <ColumnDefinition x:Name="ColumnDefinitionLast" Width="0" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BorderProjectView" Grid.Row="0" Grid.Column="0" Margin="0,8,0,0">
                    <views:ProjectView x:Name="ProjectView" FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}" CanExpandPageList="{x:Bind ShowExpandButtonInProjectView, Mode=OneWay}" ExpandPageListRequested="ExpandPageListRequested" IsExpandedChanged="ProjectView_IsExpandedChanged" />
                </Border>
                <Border x:Name="BorderScanOptions" Grid.Row="0" Grid.Column="0" Padding="0,152,0,0" BorderThickness="0,1,0,0" ui:UIElementExtensions.ClipToBounds="True">
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation Duration="{x:Bind ScanOptionsOpacityAnimationDuration, Mode=OneWay}" To="1.0" />
                        <animations:TranslationAnimation Duration="{x:Bind ScanOptionsTranslationAnimationDuration, Mode=OneWay}" To="0,0" EasingMode="EaseInOut" />
                    </animations:Implicit.ShowAnimations>

                    <animations:Implicit.HideAnimations>
                        <animations:OpacityAnimation Duration="{x:Bind ScanOptionsOpacityAnimationDuration, Mode=OneWay}" To="0.0" />
                        <animations:TranslationAnimation Duration="{x:Bind ScanOptionsTranslationAnimationDuration, Mode=OneWay}" To="0,64" EasingMode="EaseInOut" />
                    </animations:Implicit.HideAnimations>

                    <views:ScanOptionsView x:Name="ScanOptionsView" CanExpandPageList="True" FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}" ExpandPageListRequested="ExpandPageListRequested" PropertyChanged="ScanOptionsView_PropertyChanged" />
                </Border>

                <Border x:Name="BorderScanActionsView" Grid.Row="1" Grid.Column="0">
                    <views:ScanActionsView x:Name="ScanActionsView" Height="72" ScanOptions="{x:Bind ScanOptionsView.ScanOptions, Mode=OneWay}" FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}" ExpandScanOptionsRequested="ScanActionsView_ExpandScanOptionsRequested" AreScanOptionsVisibleChanged="ScanActionsView_AreScanOptionsVisibleChanged" />
                </Border>
                <Line Grid.Row="1" Grid.Column="0" X1="0" X2="1" Stretch="Fill" Stroke="{ThemeResource DividerStrokeColorDefault}" StrokeThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Visibility="{x:Bind ShowScanActionsDivider, Mode=OneWay}" />

                <Border x:Name="BorderEditor" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                    <views:EditorView FlowDirection="{x:Bind ViewModel.AccessibilityService.DefaultFlowDirection, Mode=OneWay}" />
                </Border>

                <controls:GridSplitter x:Name="GridSplitterMiddle" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="8" CornerRadius="8,0,0,0" HorizontalAlignment="Left" ResizeBehavior="PreviousAndCurrent" ResizeDirection="Columns" IsThumbVisible="False" />
                <controls:GridSplitter x:Name="GridSplitterLast" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="8" CornerRadius="0,8,0,0" HorizontalAlignment="Right" ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" IsThumbVisible="False" Visibility="Collapsed" />
            </Grid>

            <!-- Notifications -->
            <Frame Grid.Row="1" Grid.Column="0" Margin="24,24,24,72" CornerRadius="8" Background="{ThemeResource SystemControlAcrylicElementBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="{x:Bind InfoBarNotifications.IsOpen, Mode=OneWay}" ui:VisualExtensions.Scale="0,0" ui:VisualExtensions.NormalizedCenterPoint="0.5,1">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow Offset="0,4" BlurRadius="24" Color="Black" Opacity="0.1" CornerRadius="8" />
                </ui:Effects.Shadow>

                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation Duration="0:0:0.5" From="0.0" To="1.0" />
                    <animations:ScaleAnimation Duration="0:0:0.5" From="0,0" To="1,1" EasingMode="EaseOut"/>
                </animations:Implicit.ShowAnimations>

                <InfoBar x:Name="InfoBarNotifications" MaxWidth="448" CornerRadius="8">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StackedNotificationsBehavior x:Name="NotificationQueue" />
                    </interactivity:Interaction.Behaviors>
                </InfoBar>
            </Frame>
        </Grid>

        <TeachingTip x:Name="TeachingTipFeedback" PreferredPlacement="Bottom" PlacementMargin="4" Title="{x:Bind strings:Resources.FeedbackDialogHeading}" Subtitle="{x:Bind strings:Resources.FeedbackDialogSubheading}">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xED15;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </TeachingTip.IconSource>

            <StackPanel Orientation="Vertical" Spacing="4" Margin="0,12,0,0">
                <Button x:Name="ButtonTeachingTipFeedbackGiveFeedback" Content="{x:Bind strings:Resources.GiveFeedback}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ShowFeedbackCommand}" Click="ButtonTeachingTipFeedbackGiveFeedback_Click" />
                <Button Content="{x:Bind strings:Resources.SupportDevelopment}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ShowDonationDialogCommand}" />
            </StackPanel>
        </TeachingTip>

        <TeachingTip x:Name="TeachingTipUpdated" PreferredPlacement="Bottom" PlacementMargin="4" Title="{x:Bind strings:Resources.AppUpdatedDialogHeading}" Subtitle="{x:Bind strings:Resources.AppUpdatedDialogBody}" ActionButtonContent="{x:Bind strings:Resources.Changelog}" ActionButtonCommand="{x:Bind ViewModel.ShowChangelogDialogCommand}" ActionButtonStyle="{StaticResource AccentButtonStyle}">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xF133;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
            </TeachingTip.IconSource>
        </TeachingTip>
    </Grid>
</Page>
