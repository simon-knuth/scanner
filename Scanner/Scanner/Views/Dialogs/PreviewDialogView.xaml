<ContentDialog
    x:Class="Scanner.Views.Dialogs.PreviewDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:interfaces="using:Scanner.Models.Interfaces"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:local="using:Scanner"
    xmlns:strings="using:Scanner.Resources.Strings"
    xmlns:converters="using:Scanner.Views.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:Scanner.Helpers"
    mc:Ignorable="d"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText=""
    CloseButtonText=""
    FlowDirection="{x:Bind AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
    Closed="ContentDialog_Closed"
    Loaded="ContentDialog_Loaded">
    
    
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- XAML Converters -->
            <converters:EnumIntComparisonConverter x:Key="EnumIntComparisonConverter"/>
            <converters:NegativeBoolConverter x:Key="NegativeBoolConverter"/>
            <converters:NegativeBoolVisibilityConverter x:Key="NegativeBoolVisibilityConverter"/>
            <converters:ToolTipConverter x:Key="ToolTipConverter"/>

            <!-- Other -->
            <x:Double x:Key="ContentDialogMaxWidth">756</x:Double>
            <Thickness x:Key="AppBarButtonContentViewboxMargin">0,16,0,2</Thickness>
            <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">400</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <Grid MinWidth="200" MinHeight="300" Margin="-24,-25,-24,-25" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Button x:Name="ButtonBack" Grid.Row="0" Margin="4" Width="40" Height="40" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource MutedButtonStyle}" IsEnabled="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind strings:Resources.Back}" Click="ButtonBack_Click">
            <AnimatedIcon>
                <AnimatedIcon.Source>
                    <animatedvisuals:AnimatedBackVisualSource/>
                </AnimatedIcon.Source>
                <AnimatedIcon.FallbackIconSource>
                    <SymbolIconSource Symbol="Back"/>
                </AnimatedIcon.FallbackIconSource>
            </AnimatedIcon>
        </Button>

        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
            <StackPanel x:Name="StackPanelToolbarNoCustomRegion" Orientation="Horizontal" HorizontalAlignment="Center" x:Load="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind strings:Resources.PreviewHeading}" AutomationProperties.HeadingLevel="Level1"/>
                    <AppBarSeparator Margin="16,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ButtonToolbarSelectRegion" Margin="4" Width="40" Height="40" VerticalAlignment="Center" Style="{StaticResource MutedButtonStyle}" ToolTipService.ToolTip="{x:Bind strings:Resources.PreviewSelectRegionHeading}" AutomationProperties.Name="{x:Bind strings:Resources.PreviewSelectRegionHeading}" IsEnabled="{x:Bind ViewModel.HasPreviewSucceeded, Mode=OneWay}">
                        <interactivity:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="Click">
                                <core:ChangePropertyAction TargetObject="{x:Bind ViewModel}" PropertyName="IsCustomRegionSelected" Value="True" />
                            </core:EventTriggerBehavior>
                        </interactivity:Interaction.Behaviors>

                        <FontIcon Glyph="&#xEF20;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="StackPanelToolbarCustomRegion" Orientation="Horizontal" HorizontalAlignment="Center" x:Load="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock MaxWidth="224" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind strings:Resources.PreviewSelectRegionHeading}" AutomationProperties.HeadingLevel="Level1"/>
                    <AppBarSeparator Margin="16,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ToggleButtonToolbarAspectRatio" Margin="4" Height="40" MaxWidth="200" Style="{StaticResource EditorButtonWithTextStyle}" IsEnabled="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind strings:Resources.AspectRatio}" AutomationProperties.Name="{x:Bind strings:Resources.AspectRatio}">
                        <Grid ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Glyph="&#xE799;" FontSize="16" VerticalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind strings:Resources.AspectRatio}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>

                        <Button.Flyout>
                            <MenuFlyout x:Name="MenuFlyoutAspectRatio" Placement="Bottom">
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioCustom}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=0}" FontWeight="SemiBold" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.Custom}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioSquare}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=1}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.Square}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatio3By2}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=2}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.ThreeByTwo}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatio4By3}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=3}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.FourByThree}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioInternationalHeading}" IsEnabled="False" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioInternationalDINA}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=4}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.DinA}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioNAHeading}" IsEnabled="False" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioNAANSIA}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=5}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.AnsiA}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioNAANSIB}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=6}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.AnsiB}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioNAANSIC}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=7}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.AnsiC}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioNALegal}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=12}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.Legal}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioChineseHeading}" IsEnabled="False" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioChineseKai16}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=10}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.Kai16}"/>
                                <ToggleMenuFlyoutItem Text="{x:Bind strings:Resources.AspectRatioChineseKai32}" IsChecked="{x:Bind ViewModel.SelectedAspectRatio, Mode=OneWay, Converter={StaticResource EnumIntComparisonConverter}, ConverterParameter=11}" Click="ToggleMenuFlyoutItemAspectRatio_Click" Tag="{x:Bind helpers:AspectRatio.Kai32}"/>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind strings:Resources.FlipAspectRatio}" Icon="Orientation" Click="MenuFlyoutItemCropAspectRatioFlip_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Button x:Name="ButtonToolbarClose" Grid.Row="0" Margin="4" Width="40" Height="40" VerticalAlignment="Center" Style="{StaticResource MutedButtonStyle}" HorizontalAlignment="Right" ToolTipService.ToolTip="{x:Bind strings:Resources.Close}" AutomationProperties.Name="{x:Bind strings:Resources.Close}" Command="{x:Bind ViewModel.CloseCommand}">
            <FontIcon Glyph="&#xE10A;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
        </Button>

        <!-- Stretch ContentDialog -->
        <Border Grid.Row="1" Width="1000" Height="1000" Background="Transparent" />

        <!-- Content -->
        <Grid Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid x:Name="GridContentNoCustomRegion" Visibility="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay, Converter={StaticResource NegativeBoolVisibilityConverter}}">
                <ProgressRing x:Name="ProgressRingPreview" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsPreviewRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsPreviewRunning, Mode=OneWay}" />
                <Image Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasPreviewFailed, Mode=OneWay}" Margin="24" MaxWidth="400">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <FontIcon Grid.Row="0" Glyph="&#xE783;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12" Foreground="{ThemeResource SystemErrorTextColor}" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                    <TextBlock Grid.Row="1" TextAlignment="Center" TextWrapping="WrapWholeWords" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind strings:Resources.ErrorMessagePreview}" />
                </Grid>
            </Grid>

            <controls:ImageCropper x:Name="ImageCropperPreview" Style="{StaticResource CustomImageCropperStyle}" CropShape="Rectangular" ThumbPlacement="All" Padding="32" Background="Transparent" ManipulationCompleted="ImageCropperPreview_ManipulationCompleted" Visibility="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay}">
                <controls:ImageCropper.Mask>
                    <SolidColorBrush Color="Black" Opacity="0.5"/>
                </controls:ImageCropper.Mask>
            </controls:ImageCropper>
        </Grid>

        <!-- Footer -->
        <Frame x:Name="FrameFooter" Grid.Row="2" Background="{ThemeResource NavigationViewContentBackground}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="6,0,6,0" CornerRadius="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button x:Name="ButtonApplySelection" Grid.Column="0" VerticalAlignment="Stretch" MinWidth="100" Margin="3,0,0,0" Style="{ThemeResource AccentButtonStyle}" Visibility="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay}" Command="{x:Bind ViewModel.ApplyAndCloseCommand}">
                    <TextBlock Text="{x:Bind strings:Resources.Confirm}" Style="{StaticResource BodyTextBlockStyle}"/>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="{x:Bind ViewModel.HasPreviewSucceeded, Mode=OneWay}">
                    <Grid Padding="12,0,12,0">
                        <StackPanel x:Name="StackPanelFooterNoCustomRegion" Orientation="Horizontal" VerticalAlignment="Stretch" x:Load="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}">
                            <FontIcon Glyph="&#xECC6;" FontSize="16" Margin="0,0,4,0" Foreground="{ThemeResource DefaultTextForegroundThemeBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            <NumberBox x:Name="NumberBoxPreviewWidth" Value="{x:Bind ViewModel.MaxWidth.Display, Mode=OneWay}" IsEnabled="False" SpinButtonPlacementMode="Hidden" Background="Transparent" Margin="3,0,3,0" VerticalAlignment="Center" Padding="5,6,5,6" MinWidth="32" ToolTipService.ToolTip="{x:Bind strings:Resources.PreviewWidthToolTip}" AutomationProperties.Name="{x:Bind strings:Resources.PreviewWidthToolTip}" Loaded="NumberBox_Loaded" />
                            <FontIcon Glyph="&#xE947;" FontSize="12" Margin="4,0,4,0" Foreground="{ThemeResource DefaultTextForegroundThemeBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            <NumberBox x:Name="NumberBoxPreviewHeight" Value="{x:Bind ViewModel.MaxHeight.Display, Mode=OneWay}" IsEnabled="False" SpinButtonPlacementMode="Hidden" Background="Transparent" Margin="3,0,3,0" VerticalAlignment="Center" Padding="5,6,5,6" MinWidth="32" ToolTipService.ToolTip="{x:Bind strings:Resources.PreviewHeightToolTip}" AutomationProperties.Name="{x:Bind strings:Resources.PreviewHeightToolTip}" Loaded="NumberBox_Loaded" />
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="4,0,0,0" VerticalAlignment="Center" Loaded="TextBlockUnit_Loaded" />
                        </StackPanel>

                        <StackPanel x:Name="StackPanelFooterCustomRegion" Orientation="Horizontal" VerticalAlignment="Stretch" x:Load="{x:Bind ViewModel.IsCustomRegionSelected, Mode=OneWay}">
                            <FontIcon Glyph="&#xECC6;" FontSize="16" Margin="0,0,4,0" Foreground="{ThemeResource DefaultTextForegroundThemeBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            <NumberBox x:Name="NumberBoxSelectedWidth" Value="{x:Bind ViewModel.SelectedWidth.Display, Mode=OneWay}" Minimum="{x:Bind ViewModel.MinWidthForAspectRatio.Display, Mode=OneWay}" Maximum="{x:Bind ViewModel.MaxWidthForAspectRatio.Display, Mode=OneWay}" SpinButtonPlacementMode="Hidden" Background="Transparent" Margin="3,0,3,0" VerticalAlignment="Center" Padding="5,6,5,6" MinWidth="32" ToolTipService.ToolTip="{x:Bind strings:Resources.PreviewSelectedWidthToolTip}" AutomationProperties.Name="{x:Bind strings:Resources.PreviewSelectedWidthToolTip}" KeyDown="NumberBoxWidth_KeyDown" Loaded="NumberBox_Loaded" ValueChanged="NumberBoxWidth_ValueChanged" />
                            <FontIcon Glyph="&#xE947;" FontSize="12" Margin="4,0,4,0" Foreground="{ThemeResource DefaultTextForegroundThemeBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                            <NumberBox x:Name="NumberBoxSelectedHeight" x:Uid="OptionPreviewSelectedHeight" Value="{x:Bind ViewModel.SelectedHeight.Display, Mode=OneWay}" Minimum="{x:Bind ViewModel.MinHeightForAspectRatio.Display, Mode=OneWay}" Maximum="{x:Bind ViewModel.MaxHeightForAspectRatio.Display, Mode=OneWay}" SpinButtonPlacementMode="Hidden" Background="Transparent" Margin="3,0,3,0" VerticalAlignment="Center" Padding="5,6,5,6" MinWidth="32" ToolTipService.ToolTip="{x:Bind strings:Resources.PreviewSelectedHeightToolTip}" AutomationProperties.Name="{x:Bind strings:Resources.PreviewSelectedHeightToolTip}" KeyDown="NumberBoxHeight_KeyDown" Loaded="NumberBox_Loaded" ValueChanged="NumberBoxHeight_ValueChanged" />
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Margin="4,0,0,0" VerticalAlignment="Center" Loaded="TextBlockUnit_Loaded" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Frame>
    </Grid>
</ContentDialog>
