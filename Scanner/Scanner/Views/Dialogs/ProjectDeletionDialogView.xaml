<ContentDialog
    x:Class="Scanner.Views.Dialogs.ProjectDeletionDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:interfaces="using:Scanner.Models.Interfaces"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:strings="using:Scanner.Resources.Strings"
    mc:Ignorable="d"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="{x:Bind strings:Resources.DeleteProjectDialogHeading}"
    Content="{x:Bind strings:Resources.DeleteProjectDialogBody}"
    PrimaryButtonText="{x:Bind strings:Resources.Delete}"
    CloseButtonText="{x:Bind strings:Resources.Cancel}"
    DefaultButton="Close"
    CloseButtonStyle="{ThemeResource AccentButtonStyle}"
    FlowDirection="{x:Bind AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">200</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
</ContentDialog>
