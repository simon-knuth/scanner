<ContentDialog
    x:Class="Scanner.Views.Dialogs.SetupDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:interfaces="using:Scanner.Models.Interfaces"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:local="using:Scanner"
    xmlns:strings="using:Scanner.Resources.Strings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText="{x:Bind strings:Resources.Confirm}"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    FlowDirection="{x:Bind AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Closing="ContentDialog_Closing">

    
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">348</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <ContentDialog.Title>
        <StackPanel Orientation="Vertical" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{x:Bind strings:Resources.SetupDialogPrivacyHeading}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{x:Bind strings:Resources.SetupDialogPrivacyFooter}" Style="{StaticResource BodyTextBlockStyle}"/>
        </StackPanel>
    </ContentDialog.Title>

    <ScrollViewer Margin="-24,0,-24,-24" Padding="24,0,24,12">
        <StackPanel Orientation="Vertical">
            <controls:SettingsCard Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Header="{x:Bind strings:Resources.SettingsErrorReportsHeading}" Description="This helps investigate bugs and makes the app better for everyone.&#x0a;Rest assured that your scans are never included in these reports.">
                <controls:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                </controls:SettingsCard.Resources>
                
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEBE8;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                </controls:SettingsCard.HeaderIcon>

                <ToggleSwitch IsOn="{x:Bind ProxySettingErrorStatistics, Mode=TwoWay}" />
            </controls:SettingsCard>
            
            <controls:SettingsCard Background="Transparent" BorderBrush="Transparent">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72E;" Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}" />
                </controls:SettingsCard.HeaderIcon>

                <controls:SettingsCard.Header>
                    <TextBlock Text="{x:Bind strings:Resources.PromisePrivacy}" Style="{StaticResource BaseTextBlockStyle}" />
                </controls:SettingsCard.Header>

                <HyperlinkButton x:Name="HyperlinkButtonPrivacyPolicy" HorizontalAlignment="Center" Click="HyperlinkButtonPrivacyPolicy_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind strings:Resources.PrivacyPolicy}" />
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71B;" />
                    </StackPanel>
                </HyperlinkButton>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
