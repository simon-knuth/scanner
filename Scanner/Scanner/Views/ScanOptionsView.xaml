<Page
    x:Class="Scanner.Views.ScanOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Scanner.Views"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:interfaces="using:Scanner.Models.Interfaces"
    xmlns:converters="using:Scanner.Views.Converters"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:strings="using:Scanner.Resources.Strings"
    xmlns:helpers="using:Scanner.Helpers"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:models="using:Scanner.Models"
    xmlns:customcontrols="using:Scanner.Controls"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:ScanOptionsViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loading">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.ViewLoadingAsyncCommand}" CommandParameter="{x:Bind DispatcherQueue}" />
        </core:EventTriggerBehavior>
        <core:EventTriggerBehavior EventName="Unloaded">
            <core:InvokeCommandAction Command="{x:Bind ViewModel.DisposeCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>


    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <media:AttachedCardShadow x:Key="ShadowScannersComboBox" Offset="0,4" BlurRadius="12" Color="Black" Opacity="0.04" CornerRadius="8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <media:AttachedCardShadow x:Key="ShadowScannersComboBox" Offset="0,4" BlurRadius="12" Color="Black" Opacity="0.08" CornerRadius="8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <media:AttachedCardShadow x:Key="ShadowScannersComboBox" Offset="0,0" BlurRadius="0" Color="Transparent" Opacity="0.0" CornerRadius="0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- DataTemplates -->
            <DataTemplate x:Name="DataTemplateScanner" x:DataType="interfaces:IScanningDevice">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8FE;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                    <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </DataTemplate>

            <!-- XAML Converters -->
            <converters:EnumStringVisibilityConverter x:Key="EnumStringVisibilityConverter" />
            <converters:NegativeBoolConverter x:Key="NegativeBoolConverter" />
            <converters:NotNullBoolConverter x:Key="NotNullBoolConverter" />
        </ResourceDictionary>
    </Page.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <Grid x:Name="GridRoot">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid x:Name="GridHeader" Grid.Row="0" Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>

                <Line Grid.Column="0" Margin="0,0,8,0" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" X1="0" Y1="0" X2="1" Y2="0" StrokeThickness="1" Stretch="UniformToFill" VerticalAlignment="Center" Visibility="{x:Bind CanExpandPageList, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind strings:Resources.ScanOptions}" MaxWidth="200" MaxLines="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" FontSize="16" Style="{StaticResource BaseTextBlockStyle}" />
                <Line Grid.Column="2" Margin="8,0,8,0" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" X1="0" Y1="0" X2="1" Y2="0" StrokeThickness="1" Stretch="UniformToFill" VerticalAlignment="Center" Visibility="{x:Bind CanExpandPageList, Mode=OneWay}" />
                <Button x:Name="ButtonPageList" Grid.Column="3" Padding="12,4,16,4" VerticalAlignment="Center" CornerRadius="12" Background="{ThemeResource SubtleFillColorTertiaryBrush}" Style="{StaticResource MutedButtonStyle}" Visibility="{x:Bind CanExpandPageList, Mode=OneWay}" Click="ButtonPageList_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7EA;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="270" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock Text="{x:Bind strings:Resources.PagesHeading}" MaxLines="1" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                    </StackPanel>
                </Button>
                <Line Grid.Column="4" Margin="8,0,0,0" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" X1="0" Y1="0" X2="1" Y2="0" StrokeThickness="1" Stretch="UniformToFill" VerticalAlignment="Center" Visibility="{x:Bind CanExpandPageList, Mode=OneWay}" />
            </Grid>
            
            <!-- Content -->
            <Grid x:Name="GridContent" Grid.Row="1" SizeChanged="GridContent_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ScrollViewerContent" Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" IsEnabled="{x:Bind ViewModel.AreScanOptionsAvailable, Mode=OneWay}" ViewChanged="ScrollViewerContent_ViewChanged">
                    <StackPanel x:Name="StackPanelContent" Orientation="Vertical" Spacing="24" Padding="20,12,20,48" SizeChanged="StackPanelContent_SizeChanged">
                        <!-- Source -->
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <RadioButton x:Name="RadioButtonSourceAutomatic" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{x:Bind IsSourceModeAutomatic, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SelectedScanner.IsAutoAllowed, Mode=OneWay}">
                                <Grid Padding="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind strings:Resources.SourceAuto}" />
                                    <FontIcon x:Name="FontIconSourceAutomaticPreview" Grid.Column="1" Glyph="&#xE773;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" ToolTipService.ToolTip="{x:Bind strings:Resources.SourcePreviewSupportedToolTip}" x:Load="{x:Bind ViewModel.SelectedScanner.IsAutoPreviewAllowed, Mode=OneWay}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="RadioButtonSourceFlatbed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{x:Bind IsSourceModeFlatbed, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SelectedScanner.IsFlatbedAllowed, Mode=OneWay}">
                                <Grid Padding="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind strings:Resources.SourceFlatbed}" />
                                    <FontIcon x:Name="FontIconSourceFlatbedPreview" Grid.Column="1" Glyph="&#xE773;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" ToolTipService.ToolTip="{x:Bind strings:Resources.SourcePreviewSupportedToolTip}" x:Load="{x:Bind ViewModel.SelectedScanner.IsFlatbedPreviewAllowed, Mode=OneWay}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="RadioButtonSourceFeeder" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{x:Bind IsSourceModeFeeder, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SelectedScanner.IsFeederAllowed, Mode=OneWay}">
                                <Grid Padding="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind strings:Resources.SourceFeeder}" />
                                    <FontIcon x:Name="FontIconSourceFeederPreview" Grid.Column="1" Glyph="&#xE773;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" ToolTipService.ToolTip="{x:Bind strings:Resources.SourcePreviewSupportedToolTip}" x:Load="{x:Bind ViewModel.SelectedScanner.IsFeederPreviewAllowed, Mode=OneWay}" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- File format -->
                        <StackPanel Orientation="Vertical" Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="{x:Bind strings:Resources.FileFormatHeading}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                            <ComboBox x:Name="ComboBoxFileFormats" MaxDropDownHeight="800" HorizontalAlignment="Stretch" Padding="12,6,28,6" Height="32" SelectedIndex="{x:Bind TargetFormat, Mode=TwoWay}">
                                <ComboBox.Items>
                                    <ComboBoxItem Content="{x:Bind strings:Resources.MultiPageFormats}" Padding="8,4,8,4" FontSize="12" IsEnabled="False" />
                                    <ComboBoxItem FontWeight="SemiBold">
                                        <Grid ColumnSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xEA90;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="PDF" MaxLines="1" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatDescriptionPDF}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{x:Bind strings:Resources.SinglePageFormats}" Padding="8,12,8,4" FontSize="12" IsEnabled="False" />
                                    <ComboBoxItem FontWeight="SemiBold">
                                        <Grid ColumnSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE91B;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="JPG" MaxLines="1" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatDescriptionJPG}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </ComboBoxItem>
                                    <ComboBoxItem FontWeight="SemiBold">
                                        <Grid ColumnSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE91B;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="PNG" MaxLines="1" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatDescriptionPNG}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </ComboBoxItem>
                                    <ComboBoxItem FontWeight="SemiBold">
                                        <Grid ColumnSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE91B;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="BMP" MaxLines="1" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatDescriptionBMP}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </ComboBoxItem>
                                    <ComboBoxItem FontWeight="SemiBold">
                                        <Grid ColumnSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xEA90;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatSinglePagePDF}" MaxLines="1" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatDescriptionSinglePagePDF}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </ComboBoxItem>
                                    <ComboBoxItem Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE91B;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="TIFF" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatDescriptionTIFF}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </ComboBoxItem>
                                    <ComboBoxItem Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE91B;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="RAW" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.FileFormatDescriptionRAW}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </ComboBoxItem>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Color mode -->
                        <StackPanel x:Name="StackPanelColorMode" Orientation="Vertical" Spacing="8" Margin="0,12,0,0" x:Load="{x:Bind IsColorModeResolutionBrightnessContrastVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind strings:Resources.ColorModeHeading}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                            <StackPanel Orientation="Vertical" Spacing="4">
                                <RadioButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{x:Bind IsColorModeColor, Mode=TwoWay}" Visibility="{x:Bind IsColorModeColorSupported, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind strings:Resources.ColorModeColor}" Margin="4,0,0,0" />
                                </RadioButton>
                                <RadioButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{x:Bind IsColorModeGrayscale, Mode=TwoWay}" Visibility="{x:Bind IsColorModeGrayscaleSupported, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind strings:Resources.ColorModeGrayscale}" Margin="4,0,0,0" />
                                </RadioButton>
                                <RadioButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{x:Bind IsColorModeMonochrome, Mode=TwoWay}" Visibility="{x:Bind IsColorModeMonochromeSupported, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind strings:Resources.ColorModeMonochrome}" Margin="4,0,0,0" />
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Resolution -->
                        <StackPanel x:Name="StackPanelResolution" Orientation="Vertical" Spacing="12" Margin="0,12,0,0" x:Load="{x:Bind IsColorModeResolutionBrightnessContrastVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind strings:Resources.ResolutionHeading}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                            <ComboBox x:Name="ComboBoxResolution" HorizontalAlignment="Stretch" IsEditable="True" SelectedItem="{x:Bind SelectedResolution, Mode=OneWay}" ItemsSource="{x:Bind Resolutions, Mode=OneWay}" TextSubmitted="ComboBoxResolution_TextSubmitted" SelectionChanged="ComboBoxResolution_SelectionChanged" />
                        </StackPanel>

                        <!-- Scan area -->
                        <StackPanel x:Name="StackPanelScanArea" Orientation="Vertical" Spacing="12" Margin="0,12,0,0" x:Load="{x:Bind IsScanAreaSelectionVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind strings:Resources.ScanAreaHeading}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                            <Grid>
                                <ComboBox x:Name="ComboBoxScanArea" MaxDropDownHeight="800" Padding="12,5,68,7" HorizontalAlignment="Stretch" SelectionChanged="ComboBoxScanArea_SelectionChanged" Loading="ComboBoxScanArea_Loading">
                                    <ComboBox.Items>
                                        <ComboBoxItem x:Name="ComboBoxItemScanEverything">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="&#xE9A6;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                <TextBlock Grid.Column="1" Text="Everything" />
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem IsEnabled="False" Margin="-16,0,-16,0" Height="36">
                                            <MenuFlyoutSeparator />
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{x:Bind strings:Resources.AspectRatioInternationalHeading}" Height="36" Padding="8,4,8,4" FontSize="12" IsEnabled="False" />
                                        <ComboBoxItem Content="{x:Bind strings:Resources.PaperSizeInternationalDINA3}" Tag="{x:Bind helpers:PaperSize.DinA3}"/>
                                        <ComboBoxItem Content="{x:Bind strings:Resources.PaperSizeInternationalDINA4}" Tag="{x:Bind helpers:PaperSize.DinA4}"/>
                                        <ComboBoxItem Content="{x:Bind strings:Resources.PaperSizeInternationalDINA5}" Tag="{x:Bind helpers:PaperSize.DinA5}"/>
                                        <ComboBoxItem Content="{x:Bind strings:Resources.AspectRatioNAHeading}" Height="36" Padding="8,4,8,4" FontSize="12" IsEnabled="False" />
                                        <ComboBoxItem Content="{x:Bind strings:Resources.AspectRatioNAANSIA}" Tag="{x:Bind helpers:PaperSize.AnsiA}" />
                                        <ComboBoxItem Content="{x:Bind strings:Resources.AspectRatioNAANSIB}" Tag="{x:Bind helpers:PaperSize.AnsiB}" />
                                        <ComboBoxItem Content="{x:Bind strings:Resources.AspectRatioNAANSIC}" Tag="{x:Bind helpers:PaperSize.AnsiC}" />
                                        <ComboBoxItem Content="{x:Bind strings:Resources.AspectRatioNALegal}"  Tag="{x:Bind helpers:PaperSize.Legal}" />
                                        <ComboBoxItem x:Name="ComboBoxItemSeparatorAutoCrop" IsEnabled="False" Margin="-16,0,-16,0" Height="36" x:Load="{x:Bind IsAutoCropVisible, Mode=OneWay}">
                                            <MenuFlyoutSeparator />
                                        </ComboBoxItem>
                                        <ComboBoxItem x:Name="ComboBoxItemAutoCropHeading" Content="{x:Bind strings:Resources.AutoCropHeading}" FontSize="12" IsEnabled="False" x:Load="{x:Bind IsAutoCropVisible, Mode=OneWay}" />
                                        <ComboBoxItem x:Name="ComboBoxItemAutoCropSingle" IsEnabled="{x:Bind IsAutoCropSingleSupported, Mode=OneWay}" x:Load="{x:Bind IsAutoCropVisible, Mode=OneWay}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind strings:Resources.AutoCropSingle}" MaxLines="1" />
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem x:Name="ComboBoxItemAutoCropMulti" IsEnabled="{x:Bind IsAutoCropSingleSupported, Mode=OneWay}" x:Load="{x:Bind IsAutoCropVisible, Mode=OneWay}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="1+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind strings:Resources.AutoCropMultiple}" MaxLines="1" />
                                            </Grid>
                                        </ComboBoxItem>
                                        <ComboBoxItem IsEnabled="False" Margin="-16,0,-16,0" Height="36">
                                            <MenuFlyoutSeparator />
                                        </ComboBoxItem>
                                        <ComboBoxItem x:Name="ComboBoxItemPreviewSelection" x:Load="{x:Bind CanPreviewScan, Mode=OneWay}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="&#xEF20;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                <TextBlock Grid.Column="1" Text="Preview selection" MaxLines="1" />
                                            </Grid>
                                        </ComboBoxItem>
                                    </ComboBox.Items>
                                </ComboBox>
                                <Button x:Name="ButtonScanAreaAlignment" Margin="0,1,40,1" Padding="8,4,8,4" Style="{StaticResource MutedButtonStyle}" ToolTipService.ToolTip="{x:Bind strings:Resources.ScanAreaAlignmentHeading}" HorizontalAlignment="Right" VerticalAlignment="Stretch" CornerRadius="0" HorizontalContentAlignment="Stretch" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Background="{ThemeResource SubtleFillColorTertiaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,1,0" x:Load="{x:Bind IsScanAreaAlignmentVisible, Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" Visibility="{x:Bind SelectedOrientation, Mode=OneWay, Converter={StaticResource EnumStringVisibilityConverter}, ConverterParameter=Portrait}" />
                                        <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" Visibility="{x:Bind SelectedOrientation, Mode=OneWay, Converter={StaticResource EnumStringVisibilityConverter}, ConverterParameter=Landscape}" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="270" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>

                                        <FontIcon Grid.Column="1" Glyph="&#xE744;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" Visibility="{x:Bind IsTopLeftScanCornerSelected, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                        <FontIcon Grid.Column="1" Glyph="&#xE744;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" Visibility="{x:Bind IsTopRightScanCornerSelected, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="180" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                        <FontIcon Grid.Column="1" Glyph="&#xE744;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" Visibility="{x:Bind IsBottomRightScanCornerSelected, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="270" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                        <FontIcon Grid.Column="1" Glyph="&#xE744;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" Visibility="{x:Bind IsBottomLeftScanCornerSelected, Mode=OneWay}" />
                                    </Grid>

                                    <Button.Flyout>
                                        <Flyout x:Name="FlyoutScanAreaAlignment" Placement="Right">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>

                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.ThemeDictionaries>
                                                            <ResourceDictionary x:Key="Default">
                                                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorBaseBrush" />
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="Light">
                                                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                                                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorBaseBrush" />
                                                            </ResourceDictionary>
                                                        </ResourceDictionary.ThemeDictionaries>
                                                    </ResourceDictionary>
                                                </Grid.Resources>

                                                <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4" CornerRadius="7,7,0,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Margin="-16,-16,-16,0" Padding="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    <TextBlock Text="{x:Bind strings:Resources.ScanAreaAlignmentHeading}" Style="{StaticResource BaseTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind strings:Resources.ScanAreaAlignmentBody}" Style="{StaticResource BodyTextBlockStyle}" />
                                                </StackPanel>
                                                <labs:Segmented x:Name="SegmentedPaperSizeAreaOrientation" Grid.Row="1" SelectedIndex="{x:Bind SelectedOrientationInt, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="248">
                                                    <labs:Segmented.Items>
                                                        <labs:SegmentedItem>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="1*" />
                                                                </Grid.ColumnDefinitions>

                                                                <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind strings:Resources.OrientationPortrait}" />
                                                            </Grid>
                                                        </labs:SegmentedItem>
                                                        <labs:SegmentedItem>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="1*" />
                                                                </Grid.ColumnDefinitions>

                                                                <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" RenderTransformOrigin="0.5,0.5">
                                                                    <FontIcon.RenderTransform>
                                                                        <RotateTransform Angle="270" />
                                                                    </FontIcon.RenderTransform>
                                                                </FontIcon>
                                                                <TextBlock Grid.Column="1" Text="{x:Bind strings:Resources.OrientationLandscape}" />
                                                            </Grid>
                                                        </labs:SegmentedItem>
                                                    </labs:Segmented.Items>
                                                </labs:Segmented>

                                                <customcontrols:ScanAreaAlignmentControl Grid.Row="2" LongestSide="400" MaxScanArea="{x:Bind MaxScanArea, Mode=OneWay}" PaperSize="{x:Bind SelectedPaperSize, Mode=OneWay}" PreviewBitmapUri="{x:Bind ViewModel.ScanAreaAlignmentBitmapUri, Mode=OneWay}" SelectedOrientation="{x:Bind SelectedOrientation, Mode=OneWay}" SelectedCorner="{x:Bind SelectedCorner, Mode=TwoWay}" />

                                                <StackPanel Grid.Row="3" Orientation="Vertical" Spacing="4" CornerRadius="0,0,7,7" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Margin="-16,0,-16,-16" Padding="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.UpdateScanAreaAlignmentBitmapAsyncCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <FontIcon Glyph="&#xE773;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind strings:Resources.ScanAlignmentPreview}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Grid ColumnSpacing="8" Margin="0,12,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xF167;" FontSize="16" Foreground="DeepSkyBlue" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind strings:Resources.Tip}" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind strings:Resources.ScanAreaAlignmentTip}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Feeder options -->
                        <StackPanel x:Name="StackPanelFeederOptions" Orientation="Vertical" Spacing="12" Margin="0,12,0,0" x:Load="{x:Bind IsDuplexVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind strings:Resources.FeederOptionsHeading}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                            <StackPanel Orientation="Vertical" Spacing="4">
                                <CheckBox Content="{x:Bind strings:Resources.ScanMultiplePages}" IsChecked="{x:Bind ViewModel.ScanOptions.ScanMultiplePages, Mode=TwoWay}"  HorizontalAlignment="Stretch" />
                                <CheckBox Content="{x:Bind strings:Resources.Duplex}" IsChecked="{x:Bind ViewModel.ScanOptions.Duplex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Brightness -->
                        <StackPanel x:Name="StackPanelBrightness" Orientation="Vertical" Margin="0,12,0,0" x:Load="{x:Bind IsColorModeResolutionBrightnessContrastVisible, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind strings:Resources.Brightness}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                                <NumberBox Grid.Column="1" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" MaxWidth="92" Padding="10,5,40,6" Background="Transparent" BorderThickness="0" Style="{StaticResource NoClearButtonNumberBoxStyle}" Value="{x:Bind ViewModel.ScanOptions.Brightness, Mode=TwoWay}" />
                                <Button x:Name="ButtonBrightnessReset" Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center" Style="{StaticResource MutedButtonStyle}" IsEnabled="{x:Bind CanResetBrightness, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind strings:Resources.ResetToDefault}" Command="{x:Bind ViewModel.ResetBrightnessCommand}">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </Button>
                            </Grid>
                            <Slider x:Name="SliderBrightness" VerticalAlignment="Center" TickPlacement="BottomRight" IsThumbToolTipEnabled="False" TickFrequency="100" Minimum="-100" Maximum="100" SnapsTo="StepValues" Value="{x:Bind ViewModel.ScanOptions.Brightness, Mode=TwoWay}" DoubleTapped="SliderBrightness_DoubleTapped" />
                        </StackPanel>

                        <!-- Contrast -->
                        <StackPanel x:Name="StackPanelContrast" Orientation="Vertical" Margin="0,12,0,0" x:Load="{x:Bind IsColorModeResolutionBrightnessContrastVisible, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind strings:Resources.Contrast}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" />
                                <NumberBox Grid.Column="1" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" MaxWidth="92" Padding="10,5,40,6" Background="Transparent" BorderThickness="0" Style="{StaticResource NoClearButtonNumberBoxStyle}" Value="{x:Bind ViewModel.ScanOptions.Contrast, Mode=TwoWay}" />
                                <Button x:Name="ButtonContrastReset" Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center" Style="{StaticResource MutedButtonStyle}" IsEnabled="{x:Bind CanResetContrast, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind strings:Resources.ResetToDefault}" Command="{x:Bind ViewModel.ResetContrastCommand}">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </Button>
                            </Grid>
                            <Slider x:Name="SliderContrast" VerticalAlignment="Center" TickPlacement="BottomRight" IsThumbToolTipEnabled="False" TickFrequency="100" Minimum="-100" Maximum="100" SnapsTo="StepValues" Value="{x:Bind ViewModel.ScanOptions.Contrast, Mode=TwoWay}" DoubleTapped="SliderContrast_DoubleTapped" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                
                <Grid Grid.Row="0" Padding="16,4,16,0">
                    <Frame x:Name="FrameComboBoxScanners" Margin="-8,0,-8,0" IsEnabled="{x:Bind ViewModel.ProjectService.IsScanProcessRunning, Mode=OneWay, Converter={StaticResource NegativeBoolConverter}}" ui:Effects.Shadow="{ThemeResource ShadowScannersComboBox}" SizeChanged="FrameComboBoxScanners_SizeChanged">
                        <ComboBox x:Name="ComboBoxScanners" Padding="14,11,28,11" MaxDropDownHeight="800" CornerRadius="8" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ComboBoxScanners_SelectionChanged" RightTapped="ComboBoxScanners_RightTapped">
                            <ComboBox.Items>
                                <ComboBoxItem IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ProgressRing Width="16" Height="16" Foreground="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind strings:Resources.SearchingKnownScanners}" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem IsEnabled="False" Margin="-16,-10,-16,-6" Padding="0">
                                    <MenuFlyoutSeparator />
                                </ComboBoxItem>
                                <ComboBoxItem x:Name="ComboBoxItemManageScanners">
                                    <Grid ColumnSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE712;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind strings:Resources.ManageScanners}" MaxLines="1" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Install and manage scanners in the Windows Settings app." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </ComboBoxItem>
                            </ComboBox.Items>

                            <FlyoutBase.AttachedFlyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Orientation="Vertical" MaxWidth="400">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <FontIcon Glyph="&#xEBE8;" FontSize="16" FontFamily="{StaticResource SymbolThemeFontFamily}" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                                            <TextBlock Text="Debug scanner list" Style="{StaticResource BaseTextBlockStyle}"/>
                                        </StackPanel>
                                        <TextBox Text="{x:Bind ViewModel.DebugScannerSetupProperties.Name, Mode=TwoWay}"/>
                                        <Grid Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                                <ToggleSwitch x:Name="ToggleSwitchDebugFakeScannerAuto" Header="Automatic" IsOn="{x:Bind ViewModel.DebugScannerSetupProperties.IsAutoAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Preview" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerAuto.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsAutoPreviewAllowed, Mode=TwoWay}" Margin="0,0,0,12" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                                <ToggleSwitch x:Name="ToggleSwitchDebugFakeScannerFlatbed" Header="Flatbed" IsOn="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Preview" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFlatbed.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedPreviewAllowed, Mode=TwoWay}" Margin="0,0,0,12" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                                                <CheckBox Content="Color" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFlatbed.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedColorAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Grayscale" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFlatbed.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedGrayscaleAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Monochrome" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFlatbed.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedMonochromeAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Automatic" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFlatbed.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedAutoColorAllowed, Mode=TwoWay}" Margin="0,0,0,12" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical">
                                                <CheckBox Content="Auto Crop Single" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFlatbed.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedAutoCropSingleRegionAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Auto Crop Multi" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFlatbed.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFlatbedAutoCropMultiRegionAllowed, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
                                                <ToggleSwitch x:Name="ToggleSwitchDebugFakeScannerFeeder" Header="Feeder" IsOn="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Preview" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" Margin="0,0,0,12" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederPreviewAllowed, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical">
                                                <CheckBox Content="Color" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederColorAllowed, Mode=TwoWay}"/>
                                                <CheckBox Content="Grayscale" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederGrayscaleAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Monochrome" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederMonochromeAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Automatic" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederAutoColorAllowed, Mode=TwoWay}" Margin="0,0,0,12" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical">
                                                <CheckBox Content="Auto Crop Single" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederAutoCropSingleRegionAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Auto Crop Multi" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederAutoCropMultiRegionAllowed, Mode=TwoWay}" />
                                                <CheckBox Content="Duplex" IsEnabled="{x:Bind ToggleSwitchDebugFakeScannerFeeder.IsOn, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DebugScannerSetupProperties.IsFeederDuplexSupported, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <MenuFlyoutSeparator Margin="0,12,0,12" />

                                        <StackPanel Orientation="Vertical" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="Add scanner" Command="{x:Bind ViewModel.DebugAddScannerCommand}" Style="{StaticResource AccentButtonStyle}" />
                                                <Button Content="Remove scanner" IsEnabled="{x:Bind ViewModel.SelectedScanner, Mode=OneWay, Converter={StaticResource NotNullBoolConverter}}" Command="{x:Bind ViewModel.DebugRemoveScannerCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </ComboBox>
                    </Frame>
                    <InfoBadge IsHitTestVisible="False" Margin="0,0,32,0" HorizontalAlignment="Right" Style="{StaticResource InformationalValueInfoBadgeStyle}" Value="{x:Bind ScannerCount, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
