<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	<WindowsSdkPackageVersion>10.0.22621.38</WindowsSdkPackageVersion>
    <RootNamespace>Scanner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <AppxOSMaxVersionTestedReplaceManifestVersion>false</AppxOSMaxVersionTestedReplaceManifestVersion>
	<!--<PublishAot>true</PublishAot>-->
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\contrast-standard\Logo small.svg" />
    <None Remove="Assets\Simon.jpg" />
    <None Remove="Controls\ScanOptionsPresenter.xaml" />
    <None Remove="Resources\Licenses\.NET Community Toolkit.txt" />
    <None Remove="Resources\Licenses\.NET Platform.txt" />
    <None Remove="Resources\Licenses\Sentry.txt" />
    <None Remove="Resources\Licenses\Serilog.txt" />
    <None Remove="Resources\Licenses\Windows App SDK.txt" />
    <None Remove="Resources\Licenses\WinUIEx.txt" />
    <None Remove="Resources\Tesseract Training Data\eng.traineddata" />
    <None Remove="Resources\Tesseract Training Data\tessdata\osd.traineddata" />
    <None Remove="Views\ShellView.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\Licenses\.NET Community Toolkit.txt" />
    <Content Include="Resources\Licenses\.NET Platform.txt" />
    <Content Include="Resources\Licenses\Sentry.txt" />
    <Content Include="Resources\Licenses\Serilog.txt" />
    <Content Include="Resources\Licenses\Windows App SDK.txt" />
    <Content Include="Resources\Licenses\WinUIEx.txt" />
    <Content Include="Resources\Tesseract Training Data\tessdata\eng.traineddata" />
    <Content Include="Resources\Tesseract Training Data\tessdata\osd.traineddata" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Labs.WinUI.SegmentedControl" Version="0.1.230830" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.ImageCropper" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.2.250402" />
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.250402" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.250930001-experimental1" />
    <PackageReference Include="ReswPlus" Version="0.3.1.5" />
    <PackageReference Include="Sentry" Version="5.16.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="WinUIEx" Version="2.8.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\contrast-black\" />
    <Folder Include="Assets\contrast-high\" />
    <Folder Include="Assets\contrast-white\" />
    <Folder Include="Resources\Test Images\" />
    <Folder Include="Views\DataTemplateSelectors\" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\Dialogs\DonationDialogView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\TeachingTips\AIDisclaimerTeachingTip.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\TeachingTips\CopilotRuntimeDownloadTeachingTip.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Controls\ScanOptionsPresenter.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\Dialogs\MultiEditInProgressDialogView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Dialogs\SaveOptionsDialogView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Dialogs\SaveInProgressDialogView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Dialogs\ProjectDeletionDialogView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Dialogs\UnsavedChangesDialogView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Flyouts\UndoRedoStackFlyout.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\FeedbackView.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\HistoryView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Settings\SettingsViewCustomFileNaming.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Settings\SettingsViewLicenses.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Settings\SettingsViewAbout.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Settings\SettingsViewFeedback.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Settings\SettingsViewPrivacy.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Settings\SettingsViewPersonalization.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\TemplatesView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Flyouts\TemplatesFlyout.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\ScanActionsView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\ScanOptionsView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\ProjectView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\EditorView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\ShellView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>